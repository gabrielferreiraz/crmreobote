# SOMENTE para desenvolvimento (rodar `node run.mjs` ou `node fast.mjs` nesta pasta).
# No computador instalado pelo CRM nao existe .env: o instalador guarda a chave
# protegida pelo Windows e o iniciador entrega tudo ao robo por variavel.
CRM_BASE_URL=http://localhost:3000
SERVOPA_WORKER_KEY=svw_COLE_A_CHAVE_DE_UM_COMPUTADOR_DE_TESTE

SERVOPA_BASE_URL=https://www.consorcioservopa.com.br
# Opcional, so para diagnostico local (fast.mjs). O robo instalado recebe o
# acesso da Servopa do CRM a cada coleta.
# SERVOPA_USER=CPF_OU_CNPJ
# SERVOPA_PASS=SENHA

# Limites seguros validados pelo worker.
SERVOPA_CONCURRENCY=2
SERVOPA_POLL_SECONDS=60
SERVOPA_PROFILE_DIR=.profile
