# Variáveis de ambiente do CRM Reobote.
# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo:
# ele é versionado e serve só de lista do que o servidor lê.
# Opcional = o CRM funciona sem; a funcionalidade descrita fica desligada.

# ── Banco de dados (PostgreSQL) ─────────────────────────────────────────
# Dono das tabelas: migrações (Prisma) e backup do banco.
DATABASE_URL=
# Usuário de runtime da aplicação (app_runtime), sujeito ao RLS por organização.
# Sem ela a aplicação usa DATABASE_URL.
DATABASE_URL_APP=
# Usuário somente leitura da busca global (/api/search).
DATABASE_URL_SEARCH=

# ── Autenticação ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=
# Endereço público do CRM (https://...). Webhooks e links de e-mail dependem dele.
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave que cifra os tokens do Google Agenda guardados no banco.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# "true" libera o cadastro público de novas organizações (opcional).
PUBLIC_SIGNUP_ENABLED=

# ── Cron ───────────────────────────────────────────────────────────────
# Segredo enviado pelo cron-job.org nas rotas /api/cron/*.
CRON_SECRET=

# ── WhatsApp (Evolution API) ───────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# "true" grava payloads no log para diagnóstico (opcional).
EVOLUTION_DEBUG_LOG=
WHATSAPP_WEBHOOK_DEBUG_LOG=
# Central de Leads: ligada por padrão; "false" desliga.
CENTRAL_LEADS_ENABLED=

# ── Meta (WhatsApp Cloud e Lead Ads) — opcional ─────────────────────────
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_LEAD_ADS_VERIFY_TOKEN=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_SIGNUP_CONFIG_ID=

# ── Arquivos (Cloudflare R2) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket público dos anúncios da TV.
R2_TV_ADS_BUCKET=
R2_TV_ADS_PUBLIC_URL=
# Bucket separado do backup do banco.
R2_BACKUP_ACCOUNT_ID=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET_NAME=

# ── E-mail (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── Notificações push (Web Push / VAPID) ───────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: de contato exigido pelo protocolo.
VAPID_SUBJECT=
# Mesma chave pública, exposta ao navegador.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Cartão digital ─────────────────────────────────────────────────────
# Endereço público dos cartões, se diferente de NEXTAUTH_URL (opcional).
CARD_PUBLIC_BASE_URL=

# ── Integrações com sistemas da Reobote ────────────────────────────────
ACADEMY_URL=
NEXT_PUBLIC_ACADEMY_URL=
ACADEMY_CLIENT_ID=
ACADEMY_CLIENT_SECRET=
PAINEL_NICHOS_URL=
PAINEL_NICHOS_SSO_SECRET=
SIMULADOR_URL=
SIMULADOR_SSO_SECRET=

# ── Tabelas Servopa ────────────────────────────────────────────────────
# Acesso ao painel da Servopa, entregue ao robô só durante uma coleta.
SERVOPA_USER=
SERVOPA_PASS=

# ── Planilhas (fase de testes) ─────────────────────────────────────────
# "all" libera para todo o Administrativo; sem isso vale a lista abaixo.
SHEETS_ACCESS=
# E-mails separados por vírgula com acesso antecipado.
SHEETS_BETA_USER_EMAILS=
