generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-tenancy root ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  /**
   * Horário de atendimento — janela única pra organização inteira (não por
   * regra de automação), usada pelo gatilho MESSAGE_RECEIVED via
   * `businessHoursMode` (ver lib/automations/message-trigger.ts). Formato:
   * `{ start: "08:00", end: "18:00", days: [1,2,3,4,5], timezone:
   * "America/Campo_Grande", holidays: ["2026-12-25"] }`. Null = sem horário
   * configurado (regras com modo diferente de ALWAYS simplesmente nunca
   * disparam até alguém configurar).
   */
  businessHours Json?
  /**
   * Quais e-mails de alerta automático a organização quer receber — pedido
   * explícito: "eu possa verificar o que eu quero enviar e o que eu não
   * quero" em vez de todo alerta sempre disparar sem controle (ver
   * lib/notification-settings.ts pra chaves válidas/rótulos e
   * isEmailNotificationEnabled, o único lugar que lê isto). Formato:
   * `{ whatsappConnected: true, whatsappDisconnected: false, ... }` — chave
   * ausente = liga por padrão (null inteiro = tudo ligado, comportamento de
   * sempre antes desta configuração existir). NÃO cobre todo e-mail do
   * sistema: alerta de infraestrutura (cron/backup quebrado, ver
   * lib/system-alerts.ts) fica de fora de propósito — atinge TODAS as
   * organizações de uma vez e é sinal de uma falha real, não algo que uma
   * organização deveria conseguir silenciar sozinha; e-mail de automação
   * (ação "Enviar e-mail" configurada pelo próprio usuário) já se controla
   * ativando/desativando a regra, um botão a mais aqui só duplicaria isso.
   */
  emailNotificationSettings Json?
  /**
   * Fotos padrão do Cartão Digital ESCOLHIDAS PELO DONO (ver
   * lib/digital-cards/config.ts pro padrão "de fábrica", hardcoded — este
   * campo é a camada acima dele, editável em produção sem precisar de
   * deploy). Pedido explícito: "eu posso adicionar com um botão (apenas o
   * dono) de 'manter padrão para todos', aí a imagem que eu escolher vira
   * padrão" — o dono usa uma foto que já subiu no PRÓPRIO cartão (Meu
   * Cartão) e promove pra virar o padrão de todo mundo que ainda não subiu
   * uma própria. Formato: `{ photoKey?, coverPhotoKey?, backgroundPhotoKey?
   * }` — mesmas chaves R2 de DigitalCard.photoKey/coverPhotoKey/
   * backgroundPhotoKey, resolvidas do mesmo jeito (resolveAvatarUrl, ver
   * lib/digital-cards/queries.ts). Chave ausente/null = cai pro padrão de
   * fábrica; nenhuma das duas = gradiente/ícone genérico.
   */
  digitalCardDefaults Json?

  users                  OrganizationUser[]
  pipelines              Pipeline[]
  contacts               Contact[]
  deals                  Deal[]
  tasks                  Task[]
  activities             Activity[]
  lossReasons            LossReason[]
  teams                  Team[]
  automationRules        AutomationRule[]
  whatsappInstances      WhatsAppInstance[]
  whatsappThreads        WhatsAppThread[]
  whatsappMessages       WhatsAppMessage[]
  campaigns              Campaign[]
  messageScripts         MessageScript[]
  apiKeys                ApiKey[]
  webhookSubscriptions   WebhookSubscription[]
  webhookDeliveries      WebhookDelivery[]
  leadSources            LeadSource[]
  creditTypes            CreditType[]
  jobTitles              JobTitle[]
  customFieldDefinitions CustomFieldDefinition[]
  userDailyActivities    UserDailyActivity[]
  featureUsageDaily      FeatureUsageDaily[]
  monthlyGoals           MonthlyGoal[]
  metaAdsConnection      MetaAdsConnection?
  processCategories      ProcessCategory[]
  processPipelines       ProcessPipeline[]
  processes              Process[]
  processStageHistories  ProcessStageHistory[]
  processRequests        ProcessRequest[]
  auditLogs              AuditLog[]
  undoableActions        UndoableAction[]
  productivityTipDismissals ProductivityTipDismissal[]
  tvConfig               TvDashboardConfig?
  tvDisplayLinks         TvDisplayLink[]
  digitalCards           DigitalCard[]
  digitalCardEvents      DigitalCardEvent[]
  digitalCardPresentations DigitalCardPresentation[]
  importBatches          ImportBatch[]
  shareGroups            ShareGroup[]
  processTemplates       ProcessTemplate[]
  processTemplateUsages  ProcessTemplateUsage[]
  leadRequests           LeadRequest[]
}

// ─── Usuários ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  // Dia/mês/ano de nascimento — @db.Date (não DateTime) de propósito: é um
  // dia civil puro, sem hora nem fuso, igual RG/CPF. Usar DateTime aqui
  // reabriria o mesmo tipo de bug de fuso já corrigido em lib/timezone.ts
  // (a data podia "voltar" um dia dependendo de como fosse lida). Alimenta
  // o carrossel de aniversariantes do dashboard da TV (mês/dia atual, ver
  // app/tv) — nenhuma automação usa isso ainda.
  birthDate     DateTime? @db.Date

  accounts                    Account[]
  sessions                    Session[]
  orgs                        OrganizationUser[]
  dealsOwned                  Deal[]
  tasksOwned                  Task[]
  activities                  Activity[]
  teamsLed                    Team[]                    @relation("TeamLeader")
  teamsManaged                Team[]                    @relation("TeamManager")
  pushSubscriptions           PushSubscription[]
  whatsappInstances           WhatsAppInstance[]
  campaignsCreated            Campaign[]
  messageScripts              MessageScript[]
  googleCalendarConnection    GoogleCalendarConnection?
  apiKeysCreated              ApiKey[]
  tvDisplayLinksCreated       TvDisplayLink[]
  digitalCard                 DigitalCard?
  digitalCardPresentations    DigitalCardPresentation[]
  webhookSubscriptionsCreated WebhookSubscription[]
  contactsResponsible         Contact[]                 @relation("ContactResponsavel")
  contactsLeadQualified       Contact[]                 @relation("ContactLeadQualifiedBy")
  dailyActivities             UserDailyActivity[]
  featureUsageDaily           FeatureUsageDaily[]
  monthlyGoalsUpdated         MonthlyGoal[]
  metaAdsConnectionsCreated   MetaAdsConnection[]
  processesOwned              Process[]                 @relation("ProcessOwner")
  processStageHistoryChanges  ProcessStageHistory[]     @relation("ProcessStageHistoryChangedBy")
  processRequestsCreated      ProcessRequest[]          @relation("ProcessRequestRequestedBy")
  processRequestsTargeted     ProcessRequest[]          @relation("ProcessRequestTargetUser")
  processRequestsResolved     ProcessRequest[]          @relation("ProcessRequestResolvedBy")
  processTemplatesCreated     ProcessTemplate[]
  processTemplateUsages       ProcessTemplateUsage[]
  whatsappMessagesSentAs      WhatsAppMessage[]         @relation("WhatsAppMessageSentBy")
  whatsappThreadsOwned        WhatsAppThread[]          @relation("WhatsAppThreadOwner")
  auditLogsAsActor            AuditLog[]                @relation("AuditLogActor")
  undoableActions             UndoableAction[]
  productivityTipDismissals   ProductivityTipDismissal[]
  automationRulesCreated      AutomationRule[]          @relation("AutomationRuleCreatedBy")
  importBatchesCreated        ImportBatch[]
  shareGroupsCreated          ShareGroup[]              @relation("ShareGroupCreatedBy")
  shareGroupMemberships       ShareGroupMember[]
  leadRequestsMade            LeadRequest[]             @relation("LeadRequestRequester")
  leadRequestsReceived        LeadRequest[]             @relation("LeadRequestOwner")
  leadRequestsAssigned        LeadRequest[]             @relation("LeadRequestAssignee")
  leadRequestsResolved        LeadRequest[]             @relation("LeadRequestResolvedBy")
}

// ─── Google Agenda (OAuth por usuário) ───────────────────────────────
//
// Um client OAuth só (client id/secret nas env vars) serve o app inteiro;
// cada usuário conecta a PRÓPRIA conta Google aqui, um por um — mesmo
// espírito do WhatsAppInstance (um número por vendedor, nunca compartilhado).

model GoogleCalendarConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  // E-mail da conta Google conectada — só pra mostrar "conectado como
  // fulano@gmail.com" na tela de perfil, nunca usado pra autenticar nada.
  calendarEmail String?
  // Escopo de verdade concedido pelo usuário na tela de consentimento do
  // Google (string espaço-separada, como o Google devolve — ver `scope` em
  // GoogleTokenResponse/lib/google-calendar-oauth.ts), gravado na hora da
  // troca do código OAuth. Existe porque escopo NÃO se estende
  // retroativamente num token já emitido: quando SCOPES (lib/google-
  // calendar-oauth.ts) ganhou permissão de escrita pro agendamento via API
  // v1, toda conexão feita ANTES continuou só com o escopo antigo (leitura)
  // até reconectar de novo. Guardar o que foi concedido de fato (em vez de
  // supor que bate com o SCOPES atual do código) é o que permite a tela de
  // Perfil avisar "reconecte" só pra quem precisa, sem esperar o 403 do
  // Google pra descobrir.
  scope         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Meta Ads (Lead Ads + Conversions API) ───────────────────────────
//
// Uma conexão por ORGANIZAÇÃO (não por vendedor, ao contrário do
// WhatsAppInstance) — Lead Ads pertence a uma Página do Facebook, que
// representa o negócio, não uma pessoa. `pageAccessTokenEncrypted` vem de um
// token de usuário de longa duração trocado no login OAuth (ver
// lib/meta-ads.ts) com escopos leads_retrieval (ler os leads que chegam) e
// ads_management (mandar evento de conversão) — token de página derivado de
// token de usuário de longa duração não expira sozinho enquanto o acesso não
// for revogado. `pixelId` é colado manualmente (Events Manager): pertence a
// uma Ad Account, não faz parte do fluxo de login de Página.
model MetaAdsConnection {
  id                       String   @id @default(cuid())
  organizationId           String   @unique
  pageId                   String   @unique
  pageName                 String
  pageAccessTokenEncrypted String
  pixelId                  String?
  // Token de USUÁRIO de longa duração (~60 dias) obtido no OAuth — separado
  // do pageAccessTokenEncrypted acima de propósito: token de Página não
  // consulta a Insights API de uma Ad Account (gasto/leads/CPL, ver
  // lib/meta-ads/insights.ts), só token de usuário/sistema com escopo
  // ads_management/business_management (já pedidos no login, ver SCOPES em
  // lib/meta-ads.ts) serve pra isso. Nullable: conexão feita antes dessa
  // funcionalidade existir fica sem — a UI pede pra reconectar quando falta.
  userAccessTokenEncrypted String?
  // Conta de anúncio escolhida pra reportar gasto/leads — auto-selecionada
  // no momento da conexão quando só existe uma (ver
  // lib/meta-ads/connection.ts); com mais de uma, o administrativo escolhe
  // em Configurações → Integrações. adAccountId já vem prefixado "act_..."
  // (formato que a própria API espera nas chamadas seguintes).
  adAccountId              String?
  adAccountName            String?
  adAccountCurrency        String?
  connectedById            String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User         @relation(fields: [connectedById], references: [id])
}

// ─── Notificações push (Web Push) ───────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── WhatsApp (Evolution API + API oficial da Meta) ──────────────────
//
// Uma instância (número de WhatsApp) por vendedor — nunca por organização
// inteira, pra não depender de um único número compartilhado. `instanceName`
// é o identificador que o Evolution API usa; nunca exposto ao frontend fora
// do necessário pra exibir o QR Code de pareamento.
//
// `provider` distingue as duas formas de conexão que convivem lado a lado:
// EVOLUTION (QR Code/Baileys, não-oficial, gateway único compartilhado via
// env) e META_CLOUD (API oficial via Embedded Signup, credencial própria
// por linha — ver metaAccessToken/metaPhoneNumberId/metaWabaId abaixo).
// Um vendedor pode ter até uma linha de cada tipo (@@unique inclui
// provider), mas nunca duas do mesmo tipo.

model WhatsAppInstance {
  id                     String                 @id @default(cuid())
  organizationId         String
  userId                 String
  provider               WhatsAppProvider       @default(EVOLUTION)
  instanceName           String                 @unique
  phoneNumber            String?
  status                 WhatsAppInstanceStatus @default(DISCONNECTED)
  // Só preenchidos quando provider = META_CLOUD. metaAccessToken é gravado
  // cifrado (ver lib/security/secret-crypto.ts — mesma função já usada pro
  // token OAuth do Google Calendar, reaproveitada aqui em vez de uma chave
  // nova só pra isso). metaPhoneNumberId é a chave que o webhook da Meta usa
  // pra achar a instância (metadata.phone_number_id no payload — nada a ver
  // com instanceName, que é conceito só do Evolution). Token de longa
  // duração dura ~60 dias; metaTokenExpiresAt alimenta o aviso por e-mail
  // antes de vencer (não há renovação automática nessa entrega).
  metaAccessToken        String?
  metaPhoneNumberId      String?                @unique
  metaWabaId             String?
  metaTokenExpiresAt     DateTime?
  // Quando ficou desconectado pela primeira vez nesta "queda" (null quando
  // conectado) — usado pra escalar o alerta por e-mail (1, 2, 3 dias). Zera
  // quando reconecta.
  disconnectedAt         DateTime?
  // Até qual nível de alerta já mandamos nesta queda: 0 = só o aviso
  // imediato, 1/2/3 = já mandou o de 1/2/3 dias. Nunca passa de 3 — "chega
  // de falar" depois disso.
  disconnectAlertLevel   Int                    @default(0)
  // Marca quando o cron de saúde viu pela 1ª vez um estado != "open" numa
  // instância que achávamos CONNECTED — só confirma a queda de verdade (e
  // avisa por e-mail) se isso persistir até a PRÓXIMA rodada. O Evolution às
  // vezes reporta um estado errado passageiro; sem essa confirmação, cada
  // soluço falso virava um e-mail de "desconectou" + outro de "conectou"
  // logo em seguida, um par de spam por rodada de cron.
  pendingDisconnectSince DateTime?
  // Liga/desliga separadamente o push de mensagem nova pra conversas
  // vinculadas a um Contact (CRM) e pras avulsas (Geral) — dá pra silenciar
  // o ruído do Geral sem perder aviso de lead de verdade, ou vice-versa.
  notifyOnCrmMessage     Boolean                @default(true)
  notifyOnGeralMessage   Boolean                @default(true)
  // Marcado depois de importar o histórico (evento MESSAGES_SET, disparado
  // pelo Evolution só na 1ª sincronização após escanear o QR Code) — garante
  // que a importação roda uma única vez por pareamento, nunca de novo à toa
  // a cada webhook repetido. Instâncias que já existiam antes desse recurso
  // nunca disparam esse evento de novo sozinhas, então nunca são afetadas.
  historySyncedAt        DateTime?
  // Só provider = EVOLUTION (sessão WhatsApp Web/Baileys por trás do
  // Evolution API) — IP de datacenter é um dos sinais que a própria WhatsApp
  // usa pra identificar sessão automatizada; isso deixa pronto pra usar um
  // proxy residencial/móvel assim que a organização tiver um (nunca
  // preenchido automaticamente — ver lib/whatsapp/proxy.ts). proxyPassword é
  // gravado cifrado (ver lib/security/secret-crypto.ts, mesma função do
  // token do Google/Meta).
  proxyHost              String?
  proxyPort              Int?
  proxyProtocol          String?
  proxyUsername          String?
  proxyPasswordEncrypted String?
  // Quando a instância CONECTOU pela primeira vez (ou pela primeira vez após
  // ficar >=72h desconectada — reset de "chip novo") — base do aquecimento
  // gradual de volume (ver lib/whatsapp/warmup.ts). Instância que já existia
  // antes deste campo é tratada como já aquecida (backfill na migração), pra
  // nunca derrubar de repente o volume de quem já operava normalmente.
  firstConnectedAt       DateTime?
  // Quantas vezes caiu dentro da janela de risco atual (ver
  // lib/whatsapp/health-check.ts) — reseta quando a janela expira (7 dias).
  // Instabilidade repetida é sinal de que o número está sob suspeita da
  // própria WhatsApp; acima do limite, pausa campanhas que usam essa
  // instância em vez de continuar insistindo.
  recentDisconnectCount  Int                    @default(0)
  riskWindowStartedAt    DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads            WhatsAppThread[]
  messages           WhatsAppMessage[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
}

enum WhatsAppProvider {
  EVOLUTION
  META_CLOUD
}

enum WhatsAppInstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

// Uma "conversa" existe por si só — não depende de um Contact do CRM já
// cadastrado. Toda mensagem (recebida ou enviada) sempre pertence a uma
// thread; o Contact é um vínculo opcional que aparece quando o número bate
// com um já cadastrado (na hora ou depois, promovendo a conversa pra aba
// "WhatsApp CRM" — ver lib/whatsapp/threads.ts).
model WhatsAppThread {
  id              String  @id @default(cuid())
  organizationId  String
  // Nullable de propósito (era obrigatório) — a instância pode ser apagada
  // de verdade quando o dono é desativado (ver
  // lib/whatsapp/instance-cleanup.ts's deleteInstanceForInactiveUser), e a
  // conversa não pode sumir junto (ver onDelete: SetNull abaixo e
  // ownerUserId, que preserva pra sempre QUEM era o dono, independente da
  // instância continuar existindo ou não — é o que sustenta o backup de
  // mensagens em Configurações → Usuários).
  instanceId      String?
  ownerUserId     String?
  phoneNormalized String // número normalizado da OUTRA parte, nunca da nossa instância
  whatsappName    String? // pushName do WhatsApp — melhor-esforço, pode ficar desatualizado
  // Apelido definido manualmente pra essa conversa (ver
  // app/api/whatsapp/threads/[threadId]/rename) — só é usado quando ainda
  // não existe Contact vinculado (thread em "WhatsApp Geral"). Com contato
  // vinculado, renomear edita Contact.name diretamente (mesmo nome usado em
  // todo o CRM), então esse campo fica sem uso pra essa thread. Ao contrário
  // de whatsappName, nunca é sobrescrito por um pushName novo chegando (ver
  // getOrCreateThread em lib/whatsapp/threads.ts) — é o motivo de existir:
  // um nome definido aqui pelo usuário nunca deve "voltar" pro que a Evolution manda.
  customName String?
  contactId  String?

  // Foto de perfil do WhatsApp do contato — cacheada aqui pra não bater no
  // Evolution API toda vez que o chat abre (ver app/api/whatsapp/threads/
  // [threadId]/photo). null também é cache válido: contato pode não ter foto
  // ou ter privacidade restrita; profilePicFetchedAt marca a última tentativa.
  profilePicUrl       String?
  profilePicFetchedAt DateTime?

  // Presença (online/digitando/visto por último) — só chega via webhook
  // depois que a gente se inscreve (ver lib/evolution.ts's sendPresence e
  // app/api/whatsapp/messages/[threadId]/route.ts, que renova a inscrição
  // periodicamente enquanto o chat está aberto). presenceStatus é um de
  // "available"/"unavailable"/"composing"/"recording"/"paused"; lastSeenAt
  // raramente vem preenchido (depende da privacidade de quem está do outro
  // lado) — na prática "visto por último" é aproximado por presenceUpdatedAt.
  presenceStatus       String?
  presenceUpdatedAt    DateTime?
  lastSeenAt           DateTime?
  presenceSubscribedAt DateTime?

  // Denormalizado a partir de WhatsAppMessage.createdAt (atualizado toda vez
  // que uma mensagem — ou chamada — é criada nesta conversa, ver
  // touchThreadLastMessage em lib/whatsapp/threads.ts) — é o que ordena a
  // lista de Conversas (lib/whatsapp/conversations.ts). Sem isso, achar as
  // conversas mais recentes exigia buscar TODA thread da organização (com a
  // última mensagem de cada uma via join) só pra ordenar em JS, e essa busca
  // roda a cada 5s via polling (ver conversations-view.tsx) — nula em
  // threads sem nenhuma mensagem ainda (nunca aparecem na lista de qualquer
  // forma, ver listConversations).
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance           WhatsAppInstance?   @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  ownerUser          User?               @relation("WhatsAppThreadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  contact            Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages           WhatsAppMessage[]
  campaignRecipients CampaignRecipient[]

  @@unique([instanceId, phoneNormalized])
  @@index([organizationId, contactId])
  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, lastMessageAt])
}

model WhatsAppMessage {
  id             String                   @id @default(cuid())
  organizationId String
  // Nullable pelo mesmo motivo de WhatsAppThread.instanceId — preserva a
  // mensagem quando a instância é apagada de verdade (usuário desativado).
  instanceId     String?
  threadId       String
  direction      WhatsAppMessageDirection
  type           WhatsAppMessageType      @default(TEXT)
  body           String?
  mediaUrl       String?
  metadata       Json?
  status         WhatsAppMessageStatus    @default(PENDING)
  externalId     String?                  @unique
  // Só é relevante pra mensagens INBOUND — vira true quando o chat daquela
  // conversa é aberto (GET /api/whatsapp/messages/[threadId]). Alimenta o
  // sinal de "lead respondeu" no card do negócio.
  read           Boolean                  @default(false)
  // { key, message } no formato bruto do WhatsApp/Baileys — é o que o
  // Evolution exige no campo "quoted" pra responder a esta mensagem depois
  // (tanto em mensagens recebidas quanto nas que a gente manda).
  rawPayload     Json?
  replyToId      String?
  // Marca esta mensagem (só as OUTBOUND que o motor de campanhas manda) como
  // vinda de um disparo de lista fria — indicador de primeira classe, em vez
  // de tentar adivinhar "isso parece uma campanha" comparando texto/horário
  // depois. Sem isso, os relatórios (app/(dashboard)/relatorios/page.tsx)
  // contavam qualquer mensagem enviada (conversa manual, automação) junto
  // com prospecção fria nas mesmas métricas gerais.
  campaignId     String?
  // Preenchido só quando quem operou o envio (sessão logada) é diferente do
  // dono da instância (ver WhatsAppInstance.userId) — o caso de "enviar como
  // consultor" (Dono mandando pelo número de outra pessoa) e o caso mais
  // antigo, automático, da página de Negócio (Dono/Gerente abrindo o chat do
  // negócio de outro vendedor, sempre atrelado ao WhatsApp do responsável).
  // Nunca sai daqui pro WhatsApp em si — é só rastro interno de auditoria.
  // IMPORTANTE: isso NÃO é "enviado por humano" — a esmagadora maioria das
  // mensagens humanas normais (consultor mandando pela própria instância)
  // tem esse campo nulo, igual mensagem de automação. Ver automationRuleId
  // abaixo pra essa distinção.
  sentByUserId   String?
  // Mesma ideia que campaignId acima, só que pra automação em vez de
  // campanha — marca a origem quando SEND_WHATSAPP/SEND_SCRIPT do motor de
  // Automações mandou esta mensagem (qualquer gatilho, não só
  // MESSAGE_RECEIVED). Sustenta a detecção de "atendente humano ativo
  // recentemente" (ver hasRecentHumanMessage em
  // lib/automations/message-trigger.ts: OUTBOUND sem campaignId e sem
  // automationRuleId = humano de verdade) e, de brinde, separa mensagem de
  // automação de mensagem manual nos relatórios.
  automationRuleId String?
  createdAt      DateTime                 @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  thread       WhatsAppThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyTo      WhatsAppMessage?  @relation("WhatsAppMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      WhatsAppMessage[] @relation("WhatsAppMessageReplies")
  campaign     Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sentBy       User?             @relation("WhatsAppMessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  automationRule AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)

  @@index([organizationId, threadId, createdAt])
  @@index([organizationId, instanceId])
  @@index([organizationId, threadId, direction, read])
  @@index([organizationId, campaignId])
  @@index([organizationId, threadId, automationRuleId])
  // Relatórios (app/(dashboard)/relatorios/page.tsx) agrupam por
  // instanceId/threadId filtrando organizationId+direction+campaignId (nulo
  // ou não) + intervalo de data SEM informar threadId — nenhum índice
  // existente cobre essa combinação (os de cima exigem threadId), então
  // essas consultas caíam em varredura sequencial filtrada.
  @@index([organizationId, direction, campaignId, createdAt], map: "WhatsAppMessage_org_direction_campaign_createdAt_idx")
}

enum WhatsAppMessageDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  CONTACT
  PIX
  BUTTONS
  LIST
  STICKER
  CALL
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Scripts (biblioteca de mensagens reutilizáveis) ────────────────
//
// Salvo uma vez, reaproveitado em quantas campanhas quiser — na criação da
// campanha o texto de cada script escolhido é copiado pro
// Campaign.messageTemplates (snapshot), então editar/apagar um script depois
// nunca muda uma campanha que já estava rodando com ele.

model MessageScript {
  id             String @id @default(cuid())
  organizationId String
  name           String

  // Sequência de mensagens do script (nunca um texto único) — simula uma
  // pessoa mandando várias mensagens curtas em seguida, cada uma com um
  // delay (em segundos) até a próxima:
  // [{ text: "Oi {primeiro_nome}!", delayAfterSec: 2 }, { text: "Tudo bem?", delayAfterSec: 0 }]
  // Suporta spintax `{[a|b|c]}` e variáveis `{nome}`/`{primeiro_nome}`/
  // `{cargo}`/`{empresa}`/`{cidade}`/`{saudacao}` em cada texto.
  steps Json

  // Livre, sem tabela própria — organiza/filtra a biblioteca (ex.: "abertura",
  // "follow-up"), não é uma taxonomia fixa controlada pelo admin.
  tags String[] @default([])

  // PUBLIC (padrão) = toda a organização vê e usa; PRIVATE = só quem criou
  // (mais o OWNER, mesmo acesso administrativo total que já tem em
  // Auditoria/Membros) — ver enforcement em app/api/message-scripts/**.
  visibility MessageScriptVisibility @default(PUBLIC)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

enum MessageScriptVisibility {
  PUBLIC
  PRIVATE
}

// ─── Campanhas de prospecção em massa ───────────────────────────────
//
// Envia pra uma lista de contatos (filtrada uma vez na criação, não uma
// query dinâmica — evita a lista mudar no meio do disparo) usando o próprio
// motor de WhatsApp do CRM (WhatsAppThread/WhatsAppMessage via Evolution),
// nunca um serviço externo. Um cron dedicado (lib/campaigns/engine.ts) manda
// no máximo uma mensagem por campanha a cada execução, respeitando o delay
// configurado — não é um worker próprio rodando timers em memória.

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  status         CampaignStatus @default(DRAFT)
  // MANUAL = fluxo de hoje (público por filtro de cargo/tag/cidade).
  // PIPELINE_BULK = negócios selecionados em Pipeline → Lista → "Enviar
  // mensagem em massa" — cada CampaignRecipient carrega sua própria
  // instanceId (ver abaixo) em vez de usar a instanceId única da campanha.
  source         CampaignSource @default(MANUAL)

  // Variantes de mensagem (snapshot do script na hora da criação, nunca
  // reconsultado depois): [{ steps: [{text, delayAfterSec}], weight: 1,
  // scriptId: "..." }, ...]. scriptId é só referência pra exibição ("onde
  // esse script é usado") — apagar/editar o script original não afeta isso.
  messageTemplates Json

  // Filtro usado pra montar a lista na criação — guardado só pra referência
  // (auditoria/exibição/reedição em rascunho), não é reconsultado
  // automaticamente depois: os destinatários reais são as linhas de
  // CampaignRecipient já materializadas.
  // { jobTitles: string[], tags: string[], cities: string[] } — cada lista é
  // um OR entre si, listas diferentes são AND entre si; lista vazia = não
  // filtra por esse critério.
  audienceFilter Json

  instanceId String // De qual WhatsApp conectado a campanha dispara

  delayMinSec Int  @default(30)
  delayMaxSec Int  @default(90)
  dailyCap    Int? // null = sem teto

  // Janela de envio em horário de Brasília — 0=domingo…6=sábado.
  allowedWeekdays Int[] @default([1, 2, 3, 4, 5])
  windowStartHour Int   @default(9)
  windowEndHour   Int   @default(18)

  // Reenvio automático (remarketing) pra quem não respondeu — só UM reenvio
  // por destinatário, nunca uma sequência de várias tentativas. Se
  // followUpTemplates for null, reaproveita messageTemplates no reenvio.
  followUpEnabled    Boolean @default(false)
  followUpDelayHours Int     @default(24)
  followUpTemplates  Json?

  // RMKT de várias ondas — só campanhas LEAD_CAPTURE (ver CampaignSource)
  // preenchem isso. Generaliza o followUp acima (que só permite UM reenvio)
  // pra uma sequência configurável: [{ dayOffset, templates }, ...], onde
  // dayOffset conta a partir do envio INICIAL (não da onda anterior). null/
  // vazio = só a prospecção inicial, sem nenhuma onda de remarketing.
  rmktWaves        Json?
  // Depois de quantos dias sem resposta (contados do envio inicial) o
  // destinatário vira FAILED com error "Não respondeu" (ver
  // lib/campaigns/engine.ts) — só relevante pra LEAD_CAPTURE. Deve cobrir o
  // maior dayOffset de rmktWaves (validado na criação, ver
  // lib/campaigns/lead-capture.ts).
  noReplyDays      Int?
  // Onde o negócio criado automaticamente na resposta (ver
  // lib/campaigns/reply.ts) deve cair — só LEAD_CAPTURE preenche; as demais
  // continuam caindo no pipeline padrão/1ª etapa, como sempre foi.
  targetPipelineId String?
  targetStageId    String?

  // Se true, quando um destinatário vencer noReplyDays sem responder, o
  // negócio vinculado (CampaignRecipient.dealId) é marcado LOST
  // automaticamente com noReplyLossReasonId — pedido explícito: "a opção de
  // colocar 'não respondeu' em perdido deve estar com uma opção de dar
  // perdido ou não" (antes só dava pra escolher a quantidade de dias, nunca
  // desligar a consequência). Só tem efeito em quem TEM dealId — em
  // LEAD_CAPTURE o negócio só nasce se/quando responde (ver
  // lib/campaigns/reply.ts), então nunca há o que marcar perdido ali; a UI
  // (RmktWavesFields) só oferece este toggle no contexto de negócios já
  // existentes (Pipeline → disparo em massa). Default false: mudança de
  // comportamento, não deve ligar sozinha em campanha nenhuma já criada nem
  // surpreender quem não marcou a caixinha.
  markLostOnNoReply   Boolean     @default(false)
  noReplyLossReasonId String?
  noReplyLossReason   LossReason? @relation(fields: [noReplyLossReasonId], references: [id], onDelete: SetNull)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance       WhatsAppInstance    @relation(fields: [instanceId], references: [id])
  createdBy      User                @relation(fields: [createdById], references: [id])
  targetPipeline Pipeline?           @relation(fields: [targetPipelineId], references: [id], onDelete: SetNull)
  targetStage    PipelineStage?      @relation(fields: [targetStageId], references: [id], onDelete: SetNull)
  recipients     CampaignRecipient[]
  messages       WhatsAppMessage[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  DONE
}

enum CampaignSource {
  MANUAL
  PIPELINE_BULK
  // Contatos selecionados direto na página de Clientes (checkbox), sem
  // negócio nenhum ainda — o negócio só nasce se/quando o contato responder
  // (ver lib/campaigns/reply.ts). Suporta ondas de RMKT (rmktWaves) e
  // expira sem resposta em noReplyDays.
  LEAD_CAPTURE
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  contactId  String
  status     CampaignRecipientStatus @default(PENDING)

  threadId         String? // Setado quando enviado — a conversa segue normal em Conversas dali pra frente.
  sentAt           DateTime?
  error            String?
  // Qual script (dentro do snapshot messageTemplates/followUpTemplates) foi
  // de fato sorteado pra esse destinatário — alimenta a quebra por script
  // nos relatórios de prospecção fria. Campos separados porque o envio
  // inicial e o reenvio são eventos distintos, cada um pode ter sorteado um
  // script diferente (mesmo padrão de sentAt/followUpSentAt).
  scriptId         String?
  followUpScriptId String?

  repliedAt DateTime? // Marcado pelo webhook de mensagem recebida (lib/whatsapp/events.ts).

  // Reenvio automático (remarketing) — followUpSentAt marca que já TENTOU
  // (sucesso ou falha, ver followUpError), nunca fica null de novo depois de
  // tentado, pra não reenviar em loop a cada tick do cron.
  followUpSentAt DateTime?
  followUpError  String?

  // Qual onda de Campaign.rmktWaves sai na PRÓXIMA vez (índice no array) —
  // só avança em campanhas LEAD_CAPTURE; 0 = nenhuma onda enviada ainda.
  // Quando >= rmktWaves.length, não há mais onda pra mandar (só resta
  // esperar Campaign.noReplyDays vencer e marcar FAILED).
  nextWaveIndex Int @default(0)
  // Quando a ÚLTIMA onda foi tentada (sucesso ou falha, mesmo espírito de
  // followUpSentAt acima) — nextWaveIndex sozinho diz QUAL onda já saiu
  // (nextWaveIndex - 1), mas não diz QUANDO. Pedido explícito: "deve
  // mostrar também quando foi enviado as ondas de rmkt" — sem isso a
  // coluna "Reenvio" da tela da campanha (ver lib/campaigns/list.ts) só
  // conseguia mostrar a PRÓXIMA onda prevista, nunca confirmar que uma
  // onda anterior já saiu de verdade.
  lastWaveSentAt DateTime?

  // dealId: em PIPELINE_BULK, de qual negócio esse destinatário VEIO; em
  // LEAD_CAPTURE, o negócio CRIADO automaticamente quando este destinatário
  // respondeu (ver lib/campaigns/reply.ts) — presença aqui já basta pra
  // saber que converteu, sem precisar de outro campo. instanceId: de qual
  // WhatsApp ESTE destinatário específico deve ser enviado (o do responsável
  // do negócio em PIPELINE_BULK, já que um envio em massa do Pipeline pode
  // juntar negócios de vários consultores diferentes numa mesma campanha).
  // null (campanha MANUAL/LEAD_CAPTURE, que usam sempre um único WhatsApp
  // pra campanha inteira) = usa a instanceId única da campanha, sem nenhuma
  // mudança de comportamento (ver lib/campaigns/engine.ts).
  dealId     String?
  instanceId String?

  createdAt DateTime @default(now())

  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  thread   WhatsAppThread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  deal     Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  instance WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([threadId])
  @@index([dealId])
  @@index([instanceId])
}

enum CampaignRecipientStatus {
  PENDING
  // Transitório — só existe entre o momento em que um tick do cron "reivindica"
  // este destinatário (ver claimRecipient em lib/campaigns/engine.ts) e o
  // envio de verdade terminar (SENT/FAILED). Existe especificamente pra
  // impedir que dois ticks do cron rodando ao mesmo tempo (cron-job.org não
  // garante exclusão mútua entre execuções — ver app/api/cron/campaigns)
  // escolham o MESMO destinatário PENDING e mandem a mensagem duas vezes.
  SENDING
  SENT
  FAILED
  SKIPPED
}

model OrganizationUser {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  role                  OrgRole   @default(MEMBER)
  teamId                String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  // Último heartbeat (ver lib/user-activity.ts) — só pra status "online
  // agora" (Configurações → Usuários). Sem relação com atividade/tempo no
  // CRM, isso vive em UserDailyActivity.
  lastActiveAt          DateTime?
  // Texto do convite de reunião mandado pro WhatsApp do cliente (ver
  // lib/meeting-invite.ts) — por vendedor, não por organização: cada um
  // manda pelo próprio número, então cada um tem seu próprio jeito de
  // escrever. null usa o template padrão (DEFAULT_MEETING_INVITE_TEMPLATE)
  // até a pessoa editar pela 1ª vez, quando salva automaticamente.
  meetingInviteTemplate String?
  // Acesso administrativo ao módulo de Processos (pós-venda) pra quem é da
  // área VENDAS mas precisa ajudar no pós-venda mesmo assim (ex.: um
  // gerente) — quem já é `area: ADMINISTRATIVO` NUNCA precisa deste campo,
  // sempre tem acesso total por conta da área (ver lib/processes/access.ts).
  // OWNER também sempre tem acesso administrativo mesmo com este campo
  // false, igual ao OWNER sempre ver tudo no pipeline de vendas.
  canManageProcesses    Boolean   @default(false)
  // Determina QUAL experiência a pessoa vê (início, menu, relatórios) —
  // eixo separado do `role` (que continua controlando o que ela pode FAZER
  // dentro de Vendas). ADMINISTRATIVO também dá acesso administrativo
  // automático ao módulo de Processos (vê todos os processos da
  // organização, não só os que ele mesmo ganhou) — ver lib/processes/access.ts.
  // Default VENDAS preserva o comportamento de todo usuário já existente.
  area                  UserArea  @default(VENDAS)
  // Se as vendas GANHAS desta pessoa entram na meta mensal da organização e
  // nos números "de ganho" do dashboard da TV (Vendas do mês/ano, ranking,
  // última venda, Churrascômetro) — ver lib/goals/suggestion.ts (função
  // getGoalExcludedOwnerIds) e lib/tv-dashboard.ts, os dois lêem este campo.
  // Pedido explícito: sócio (Dono) pode fechar negócio da própria Reobote de
  // vez em quando, mas isso não é meta de consultor nem "ganho" pra aparecer
  // pro time inteiro na TV — a meta é só dos consultores/supervisores/
  // gerentes. Default true (todo mundo conta) — só é gravado como false na
  // CRIAÇÃO de um membro com role OWNER (ver POST /api/org/members); depois
  // disso é 100% manual (o toggle em Configurações → Usuários), mudar o
  // papel de alguém depois NUNCA mexe aqui sozinho.
  countsTowardGoal      Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([teamId])
}

enum OrgRole {
  OWNER
  MANAGER
  SUPERVISOR
  MEMBER
}

// "Que tela essa pessoa vê" — Vendas é o CRM de sempre (Pipeline, Relatórios
// de vendas); Administrativo é o pós-venda (Processos, início só com tarefas/
// anotações, Relatórios de acompanhamento de processo). Ortogonal ao `role`
// de vendas: um Administrativo normalmente é MEMBER (não aparece em nenhum
// negócio de ninguém), mas o cargo em si não muda de significado.
enum UserArea {
  VENDAS
  ADMINISTRATIVO
}

// ─── Equipes ─────────────────────────────────────────────────────────

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Líder = papel SUPERVISOR, gerencia só esta equipe (ver getDealScope).
  leaderId       String?
  // Gerente = papel MANAGER, pode supervisionar várias equipes ao mesmo
  // tempo (um User pode aparecer em teamsManaged de N Teams diferentes).
  managerId      String?
  createdAt      DateTime @default(now())

  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leader                User?              @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  manager               User?              @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members               OrganizationUser[]
  automationRuleTargets AutomationRule[]   @relation("AutomationRuleTargetTeam")

  @@index([organizationId])
  // Usado por getDealScope (lib/team-scope.ts) — passa a rodar em toda
  // requisição de API de negócios/tarefas (não só em carregamento de página),
  // então precisa ser indexado, não só o organizationId sozinho.
  @@index([organizationId, leaderId])
  @@index([organizationId, managerId])
}

// ─── Compartilhamento entre consultores (agenda / negócios / clientes) ─
// Ortogonal a Team: um "setor" que compartilha (ex.: um time interno de
// marketing digital que cuida de leads de tráfego pago, ou duas pessoas que
// viajam juntas e cuidam dos mesmos negócios) pode cruzar equipes de vendas
// diferentes — por isso é um grupo à parte, não mais um uso do Team já
// existente. Dentro de um grupo, TODO MEMBRO vê o que foi ligado (agenda e/
// ou negócios e/ou clientes) de TODO MEMBRO (simétrico) — ver
// getSharedOwnerIds em lib/share-groups.ts. Cada recurso é um interruptor
// independente: um grupo pode compartilhar só agenda, só negócios, ou
// qualquer combinação — nunca afeta Relatórios (que continuam só com a
// visão normal de getDealScope, sem o que foi compartilhado aqui).
model ShareGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Dono do grupo pra fins de permissão: Dono da organização pode mexer em
  // qualquer grupo; Gerente/Supervisor só no que ele mesmo criou (ver
  // app/api/share-groups) — evita um Supervisor mexer num grupo multi-
  // equipe que um Gerente/Dono montou.
  createdById    String
  shareAgenda    Boolean  @default(true)
  shareDeals     Boolean  @default(false)
  shareContacts  Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("ShareGroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members      ShareGroupMember[]

  @@index([organizationId])
}

model ShareGroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group ShareGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ─── Auth.js (NextAuth v5) ───────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Pipeline (Funil) ────────────────────────────────────────────────

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages             PipelineStage[]
  deals              Deal[]
  campaignsTargeting Campaign[]

  @@index([organizationId])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  order      Int
  color      String?
  createdAt  DateTime @default(now())

  // Definido pelo admin por etapa (não pela posição): quais campos do
  // Deal precisam estar preenchidos pra um negócio poder entrar/permanecer
  // nesta etapa (ver lib/deal-required-fields.ts pra lista de campos
  // elegíveis). Etapas de nutrição (ex.: Remarketing) tipicamente ficam
  // vazias aqui — lead ainda frio, nada comprometido ainda.
  requiredFields String[] @default([])

  pipeline           Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals              Deal[]
  campaignsTargeting Campaign[]

  @@index([pipelineId, order])
}

// ─── Contatos ────────────────────────────────────────────────────────

model Contact {
  id                  String                    @id @default(cuid())
  organizationId      String
  name                String
  email               String?
  phone               String?
  whatsapp            String?
  phoneNormalized     String?
  whatsappNormalized  String?
  source              String?
  company             String?
  jobTitle            String?
  // Dia/mês/ano de nascimento do CLIENTE — mesma ideia (e mesmo tipo,
  // @db.Date puro, sem hora/fuso) de User.birthDate acima no arquivo, só que
  // pro contato, não pro consultor. Pedido explícito: "a gente não consegue
  // colocar" — o <input type="date"> nativo que essa tela usaria por padrão
  // é notoriamente ruim pra digitar um ano antigo (calendário exige clicar
  // "mês anterior" dezenas de vezes); a UI (ver components/birth-date-input.tsx)
  // usa uma máscara de texto DD/MM/AAAA em vez do seletor nativo.
  birthDate           DateTime?                 @db.Date
  address             String?
  addressNumber       String?
  addressComplement   String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  responsavelId       String?
  tags                String[]                  @default([])
  // Dado livre vindo de integração externa (/api/v1/contacts) que não mapeia
  // pra nenhum campo conhecido — guardado como veio, só exibido, sem UI de
  // gestão de schema por organização (fora de escopo).
  customFields        Json?
  // Valores dos campos personalizados definidos em CustomFieldDefinition —
  // { [customFieldDefinitionId]: string | number | boolean }. Separado do
  // customFields acima de propósito (esse é write-only da ingestão externa).
  customFieldValues   Json?
  // Pediu pra parar de receber mensagem de campanha/script (detectado por
  // palavra-chave numa resposta INBOUND — ver lib/whatsapp/opt-out.ts, ou
  // marcado manualmente). Uma vez setado, nunca mais entra em audiência de
  // campanha nem recebe follow-up automático — mensagem manual avulsa
  // (vendedor respondendo o próprio contato) continua permitida, isso só
  // bloqueia disparo em massa.
  whatsappOptOutAt    DateTime?
  // Atribuição de Lead Ads da Meta (Facebook/Instagram) — preenchido só
  // quando o contato chegou via formulário nativo de anúncio (ver
  // lib/meta-ads/leads.ts), nunca preenchido manualmente. metaLeadgenId
  // existe pra dedup: a Meta reenvia o mesmo webhook de leadgen mais de uma
  // vez às vezes, e não pode virar dois contatos/negócios duplicados.
  // metaCampaignName é o que os relatórios de conversão por origem agrupam.
  metaLeadgenId       String?                   @unique
  metaAdId            String?
  metaAdSetId         String?
  metaCampaignId      String?
  metaCampaignName    String?
  metaFormId          String?
  // Qualificação manual de lead pelo consultor — o status é o que o
  // consultor classifica (QUALIFIED / UNQUALIFIED), a data registra o
  // momento, e qualificadoPor identifica o usuário. Essa info também vai
  // de volta pro Conversions API da Meta (eventos Lead.QUALIFIED e
  // Lead.UNQUALIFIED) pra alimentar a inteligência das campanhas de anúncio.
  leadQualification   ContactLeadQualification?
  leadQualificationAt DateTime?
  leadQualificationBy String?
  // "Código da Pessoa" do Agendor — mesma ideia de agendorDealId (ver Deal):
  // chave de reconciliação pra reimportar sem duplicar.
  agendorContactId    String?                   @unique
  // De qual importação de planilha (ver ImportBatch) este contato veio —
  // null pra contato criado manualmente/por API/webhook de anúncio/etc.
  importBatchId       String?
  createdAt           DateTime                  @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsavel        User?               @relation("ContactResponsavel", fields: [responsavelId], references: [id])
  qualifiedBy        User?               @relation("ContactLeadQualifiedBy", fields: [leadQualificationBy], references: [id])
  importBatch        ImportBatch?        @relation(fields: [importBatchId], references: [id])
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  whatsappThreads    WhatsAppThread[]
  campaignRecipients CampaignRecipient[]
  processes          Process[]
  leadRequests       LeadRequest[]

  @@unique([organizationId, phoneNormalized])
  @@unique([organizationId, whatsappNormalized])
  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, responsavelId])
  // Usado pelo relatório de conversão por campanha (agrupa Deal via Contact
  // por metaCampaignId) — ver app/api/reports/meta-ads-attribution.
  @@index([organizationId, metaCampaignId])
  @@index([organizationId, importBatchId])
  // Cobre o ORDER BY createdAt DESC da listagem paginada de Clientes — sem
  // isso, o índice de organizationId sozinho acha as linhas certas mas o
  // Postgres ainda precisa ordenar TODAS elas em memória antes de aplicar o
  // take/skip (o problema não é só "sem paginação", é paginação sem índice
  // pra ordenação nunca ser realmente barata em escala).
  @@index([organizationId, createdAt])
  // Filtro de Estado (lista fechada de 27 UFs, sempre igualdade exata) — city
  // usa índice trigram à parte (ver migration 20260731 — GIN não é
  // declarável aqui, o gerador não modela esse tipo de índice) porque é
  // busca por trecho (contains), não igualdade.
  @@index([organizationId, state])
  // Índice pro novo relatório de funil Facebook → WhatsApp → Venda e pro
  // histórico de qualificação por campanha/consultor.
  @@index([organizationId, leadQualification])
  @@index([organizationId, leadQualificationAt])
}

// ─── Motivos de perda ────────────────────────────────────────────────

model LossReason {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  // false = só histórico (ex.: motivos migrados do Agendor, rotulados "...
  // (CRM anterior)") — não aparece no seletor de "por que esse negócio foi
  // perdido?" pra negócio novo (ver LossReasonDialog em deal-detail.tsx),
  // mas continua contando normal em relatório/filtro/automação, que usam
  // outras consultas sem esse filtro de propósito (é histórico de verdade,
  // não deveria sumir de onde já aconteceu, só não pode ser escolhido de
  // novo daqui pra frente).
  selectable Boolean @default(true)

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals                Deal[]
  campaignsNoReplyLoss Campaign[]

  @@index([organizationId])
}

// ─── Meta mensal de vendas ──────────────────────────────────────────
//
// Uma meta (valor em R$) por organização por mês — só Dono edita (ver
// requireRole(["OWNER"]) em app/api/goals/current/route.ts); qualquer papel
// enxerga o card em Relatórios, comparando com o total ganho no mês
// corrente. Histórico de meses passados fica guardado (não é só "a meta
// atual"), então dá pra olhar um mês antigo depois e ver se bateu.
model MonthlyGoal {
  id                 String   @id @default(cuid())
  organizationId     String
  year               Int
  month              Int // 1-12
  value              Decimal  @db.Decimal(14, 2)
  updatedAt          DateTime @updatedAt
  updatedById        String
  // Quantos consultores (role MEMBER) ativos existiam quando `value` foi
  // salvo por último (ver lib/goals/suggestion.ts) — null pra linhas
  // antigas, de antes desse campo existir. É o que permite distinguir "a
  // meta foi ajustada de propósito, não precisa sugerir nada" de "a equipe
  // mudou de tamanho depois que a meta foi definida, vale sugerir de novo":
  // só compara o VALOR de `value` com a sugestão apareceria toda vez que o
  // dono digitasse um valor fora da fórmula. `null` nunca dispara sugestão
  // de atualização (só dá pra saber que mudou comparando com uma base
  // conhecida) — evita alarme falso em toda meta já existente no dia em
  // que este campo foi introduzido.
  basedOnSellerCount Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User         @relation(fields: [updatedById], references: [id])

  @@unique([organizationId, year, month])
  @@index([organizationId])
}

// ─── Origens de lead (lista editável, alimenta o Select de "Origem" do
// contato) ────────────────────────────────────────────────────────────
//
// De propósito NÃO é FK do Contact.source (que continua String livre) —
// script de importação e a API externa /api/v1/contacts continuam aceitando
// texto livre sem bater contra essa lista. Renomear aqui não retroage sobre
// contatos que já usavam o nome antigo.

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  order          Int      @default(0)
  // Quando true, todo contato com esse texto exato em Contact.source conta
  // como "veio de anúncio" no relatório de Facebook/Instagram (ver
  // lib/meta-ads/attribution.ts) — mesmo sem ter passado pelo webhook de
  // Lead Ads (metaCampaignId null). É o jeito de marcar retroativamente
  // lead antigo (de antes da integração existir) ou lead que veio de
  // anúncio por um caminho que não é o formulário nativo: basta a origem
  // dele já estar (ou passar a estar) marcada aqui — não precisa editar
  // contato por contato. Default false de propósito: autocura de
  // origens usadas fora do gerenciador (ver configuracoes/origens/page.tsx)
  // nunca marca sozinha, sempre opt-in manual do administrativo.
  countsAsAd     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Tipos de crédito (lista editável, alimenta o Select de "Tipo de
// crédito" do negócio) ──────────────────────────────────────────────
//
// Mesmo raciocínio do LeadSource acima: de propósito NÃO é FK do
// Deal.creditType (que continua String livre) — importação e a API externa
// /api/v1/deals continuam aceitando texto livre. Renomear aqui não retroage
// sobre negócios que já usavam o nome antigo.

model CreditType {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Cargos (lista editável, alimenta o Select de "Cargo" do contato)
// ──────────────────────────────────────────────────────────────────
//
// Mesmo raciocínio do LeadSource/CreditType: de propósito NÃO é FK do
// Contact.jobTitle (que continua String livre) — importação e contatos
// antigos com valor livre continuam funcionando. Renomear aqui não retroage
// sobre contatos que já usavam o nome antigo.

model JobTitle {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Campos personalizados (definidos pelo admin, valores em Contact e
// Deal) ───────────────────────────────────────────────────────────────
//
// Guardado por id (não por um slug do label) na Json bag de cada entidade —
// renomear um campo depois nunca quebra dado já salvo nem regra de
// automação que referencia esse id.

model CustomFieldDefinition {
  id             String            @id @default(cuid())
  organizationId String
  entityType     CustomFieldEntity
  label          String
  type           CustomFieldType
  options        String[]          @default([]) // só usado quando type = SELECT
  required       Boolean           @default(false)
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, order])
}

enum CustomFieldEntity {
  CONTACT
  DEAL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

// ─── Negócio (Deal) ──────────────────────────────────────────────────

model Deal {
  id             String @id @default(cuid())
  organizationId String
  pipelineId     String
  stageId        String
  contactId      String
  ownerId        String

  name   String
  status DealStatus @default(OPEN)

  // = "Valor líquido" na UI — nome de coluna ficou como está (não vale o
  // risco de renomear com ~40 leituras/agregações espalhadas pelo sistema,
  // ver grossValue abaixo), mas é o que este campo já representa de verdade
  // desde sempre.
  value Decimal? @db.Decimal(12, 2)
  // "Valor bruto" — independente de `value`, nunca derivado/calculado dele.
  // Pedido da diretoria (08/2026): os dois precisam ser guardados
  // separados porque relatório/mapeamento/comissão vão depender disso no
  // futuro. Por enquanto só entrada/edição/exportação — nenhuma agregação
  // existente (Relatórios/TV/Metas) foi migrada pra somar isto ainda.
  grossValue Decimal? @db.Decimal(12, 2)

  creditType String?

  startedAt       DateTime  @default(now())
  expectedCloseAt DateTime?
  closedAt        DateTime?
  stageEnteredAt  DateTime  @default(now())

  description       String?
  lossReasonId      String?
  lostReason        String?
  // Valores dos campos personalizados definidos em CustomFieldDefinition —
  // { [customFieldDefinitionId]: string | number | boolean }.
  customFieldValues Json?
  // "Código do Negócio" do Agendor — chave de reconciliação da migração
  // (ver scripts/import-agendor.ts): permite reimportar sem duplicar (upsert
  // por este campo) mesmo rodando o import várias vezes ao longo do tempo,
  // conforme mais consultores forem migrando aos poucos.
  agendorDealId     String?  @unique
  // De qual importação de planilha (ver ImportBatch abaixo) este negócio
  // veio — null pra negócio criado manualmente/por API/outra integração.
  // É o que permite achar "o que esse arquivo criou" depois do fato.
  importBatchId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id])
  stage              PipelineStage       @relation(fields: [stageId], references: [id])
  contact            Contact             @relation(fields: [contactId], references: [id])
  owner              User                @relation(fields: [ownerId], references: [id])
  lossReason         LossReason?         @relation(fields: [lossReasonId], references: [id])
  importBatch        ImportBatch?        @relation(fields: [importBatchId], references: [id])
  tasks              Task[]
  activities         Activity[]
  campaignRecipients CampaignRecipient[]
  // Negócio ganho vira um Processo de pós-venda automaticamente (ver
  // lib/processes/create.ts, chamado em PUT /api/deals/[id] na transição pra
  // WON) — nunca mais de um por negócio.
  process            Process?

  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, lossReasonId])
  // Sem isso, achar o(s) negócio(s) de um contato exigia varredura sem
  // índice — usado tanto pelo EXISTS de Relatórios (dealThreads, ver
  // page.tsx) quanto por lib/campaigns/reply.ts's "já existe negócio aberto
  // pra este contato?" (roda a cada mensagem WhatsApp recebida vinculada a
  // negócio de campanha).
  @@index([organizationId, contactId])
  // Cobre organizationId+pipelineId (filtro) + stageEnteredAt (ORDER BY) do
  // board do Pipeline — sem isso, mesmo depois de filtrar status=OPEN e
  // aplicar take/skip, o Postgres teria que ordenar todo o resultado
  // filtrado em memória antes de recortar a página.
  @@index([organizationId, pipelineId, status, stageEnteredAt])
  // Relatórios (app/(dashboard)/relatorios/page.tsx) agrupam WON/LOST por
  // dono/motivo/tipo de crédito filtrando organizationId+status+intervalo de
  // closedAt — Deal_organizationId_status_idx não cobre closedAt, então um
  // filtro de período (ex.: "Este mês") ainda exigia varrer TODOS os negócios
  // decididos daquele status antes de descartar os fora do intervalo.
  @@index([organizationId, status, closedAt])
  // "Negócios parados há N dias" do Início — sem filtro de funil, então o
  // índice (organizationId, pipelineId, status, stageEnteredAt) acima não
  // serve (pipelineId no meio quebra o prefixo). Era Seq Scan, 283ms
  // medidos em produção (ver 20260920100000_performance_indexes).
  @@index([organizationId, status, stageEnteredAt])
  // "O que essa importação criou" (ver ImportBatch) — usado pra revisar/
  // conferir um lote depois do fato.
  @@index([organizationId, importBatchId])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// ─── Importação de planilha (negócios/contatos em lote) ────────────────
//
// Um registro por arquivo importado — não guarda os dados em si (isso já
// virou Contact/Deal de verdade, ver importBatchId nos dois), só metadados
// de auditoria: quem importou, quando, de qual arquivo, quantas linhas
// entraram/foram ignoradas. Existe pra responder "o que esse arquivo
// criou" depois do fato (ver app/api/deals/import/route.ts) — antes não
// tinha nenhum jeito de rastrear isso.
model ImportBatch {
  id             String    @id @default(cuid())
  organizationId String
  createdById    String
  // "deals" hoje (ver rota acima) — campo aberto (não enum) porque outros
  // tipos de importação (contatos, ex.: app/api/contacts/import) podem
  // passar a usar o mesmo model no futuro sem migração nova.
  type           String
  fileName       String
  rowsTotal      Int
  rowsCreated    Int
  rowsSkipped    Int
  // Linhas que NÃO viraram negócio (sem nome de contato, duplicidade
  // evitada, etc.) com o motivo de cada uma — mesmo formato de
  // ResolvedRow["issues"] em lib/deals/import-resolve.ts. Guardado aqui
  // (não recalculado depois) pra "baixar planilha de erros" continuar
  // funcionando mesmo que o arquivo original já tenha sido descartado.
  // Capado nas primeiras 500 pra não inflar a linha à toa numa importação
  // de 1000 linhas todas com o mesmo problema.
  issueRows      Json?
  // Preenchido quando alguém desfaz a importação (ver DELETE
  // /api/deals/import/[id]) — os negócios/contatos que ainda dava pra
  // apagar com segurança já foram removidos nesse momento; o registro em
  // si continua existindo (não é deletado) só pra manter no histórico que
  // essa importação aconteceu E foi desfeita, não sumir sem explicação.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  deals        Deal[]
  contacts     Contact[]

  @@index([organizationId, createdAt])
}

// Classificação manual de lead pelo consultor responsável — QUALIFIED
// ("Lead qualificado") ou UNQUALIFIED ("Lead desqualificado"). O evento
// correspondente é enviado de volta pro Conversions API da Meta pra
// campanha de origem aprender e otimizar a audiência.
enum ContactLeadQualification {
  QUALIFIED
  UNQUALIFIED
}

// ─── Processos (pós-venda) ────────────────────────────────────────────
//
// "CRM dentro do CRM" pro time administrativo/pós-venda — nasce sozinho
// quando um negócio é marcado como Ganho (1 processo por negócio, nunca
// mais). Kanban com etapas próprias e editáveis (mesmo padrão de
// Pipeline/PipelineStage, só que separado de propósito: etapa de venda e
// etapa de pós-venda são conceitos diferentes, e misturar os dois no mesmo
// Deal/Pipeline arriscaria o funil de vendas que já funciona hoje).
//
// Acesso: quem é OWNER, `OrganizationUser.area: ADMINISTRATIVO` ou tem
// `canManageProcesses` edita tudo — move card, cria/edita etapa, marca
// contemplado/pagamento/documentação, vê TODOS os processos da organização.
// Quem não é nenhum dos três só enxerga (leitura) os processos dos negócios
// que ELE MESMO ganhou (`Process.ownerId` — herdado do Deal de origem no
// momento da criação, nunca muda depois, mesmo se o negócio trocar de
// responsável) — ver lib/processes/access.ts.

// Categoria de processo (ex.: "Imóvel", "Automóvel") — agrupa Subcategorias
// (ver ProcessPipeline abaixo). Puramente organizacional: nada além de
// ProcessPipeline referencia isso diretamente.
model ProcessCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelines    ProcessPipeline[]

  @@index([organizationId])
}

// Apesar do nome (mantido pra não precisar renomear toda rota/consulta que
// já existe — ver app/api/process-pipelines/*), isto É a "Subcategoria" que
// a UI mostra: cada uma pertence a UMA ProcessCategory e tem seu próprio
// conjunto de ProcessStage, diferente das outras subcategorias da mesma
// categoria (ex.: Imóvel → Aquisição tem etapas diferentes de Imóvel →
// Construção).
model ProcessPipeline {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  isDefault      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     ProcessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stages       ProcessStage[]
  processes    Process[]

  @@index([organizationId])
  @@index([categoryId])
}

model ProcessStage {
  id              String   @id @default(cuid())
  pipelineId      String
  name            String
  order           Int
  color           String?
  // Etapa marcada como "conclusão" — entrar aqui dispara aviso (push) pro
  // time administrativo (ver lib/processes/notify.ts). Não precisa ser a
  // última etapa nem ser única.
  isFinal         Boolean  @default(false)
  // Prazo da etapa em dias úteis, opcional — sem isso configurado, a etapa
  // simplesmente não participa do cálculo de atraso (ver lib/processes/sla.ts).
  slaBusinessDays Int?
  createdAt       DateTime @default(now())

  pipeline       ProcessPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  processes      Process[]
  stageHistory   ProcessStageHistory[]  @relation("ProcessStageHistoryToStage")
  templateUsages ProcessTemplateUsage[]

  @@index([pipelineId])
}

enum DocumentStatus {
  NOT_REQUESTED
  PENDING_DELIVERY
  DELIVERED
}

model Process {
  id             String @id @default(cuid())
  organizationId String
  pipelineId     String
  stageId        String
  dealId         String @unique
  contactId      String
  // Herdado do Deal.ownerId no momento em que o processo nasce (negócio
  // marcado como Ganho) — nunca reflete mudança de responsável do negócio
  // depois disso; é o "dono" fixo pro escopo de leitura do consultor.
  ownerId        String

  // Marcador independente da etapa atual do Kanban — um processo pode estar
  // em qualquer etapa E já ter documentação pendente ao mesmo tempo; o
  // filtro da lista cruza com qualquer etapa.
  documentStatus DocumentStatus @default(NOT_REQUESTED)
  // Cadastrados pelo administrativo assim que o cliente entra no consórcio —
  // número da cota e do grupo, não texto livre (dá pra buscar/filtrar por
  // qualquer um dos dois depois).
  quotaNumber    String?
  groupNumber    String?

  stageEnteredAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       ProcessPipeline        @relation(fields: [pipelineId], references: [id])
  stage          ProcessStage           @relation(fields: [stageId], references: [id])
  deal           Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact        Contact                @relation(fields: [contactId], references: [id])
  owner          User                   @relation("ProcessOwner", fields: [ownerId], references: [id])
  stageHistory   ProcessStageHistory[]
  requests       ProcessRequest[]
  templateUsages ProcessTemplateUsage[]
  // Notas do administrativo sobre este processo (Activity.type = NOTE,
  // reaproveitando o mesmo model do Negócio — ver Activity.processId) —
  // alimenta o feed de "anotações" no início do Administrativo.
  activities     Activity[]

  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, quotaNumber])
  @@index([organizationId, groupNumber])
}

// Auditoria de movimentação de etapa — quem, quando, de onde pra onde.
// Nunca editado/apagado depois de criado (é o próprio registro de auditoria).
model ProcessStageHistory {
  id             String   @id @default(cuid())
  processId      String
  organizationId String
  fromStageId    String?
  toStageId      String
  changedById    String
  changedAt      DateTime @default(now())

  process      Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toStage      ProcessStage @relation("ProcessStageHistoryToStage", fields: [toStageId], references: [id])
  changedBy    User         @relation("ProcessStageHistoryChangedBy", fields: [changedById], references: [id])

  @@index([processId])
  @@index([organizationId])
}

// De mão dupla: (a) consultor avisando o administrativo de algo (botão
// "Solicitar", sem precisar de acesso de edição) — `targetUserId` null,
// resolve = admin; (b) administrativo pedindo algo AO consultor (via "Enviar
// modelo", ver ProcessTemplate) — `targetUserId` = o consultor (dono do
// processo), resolve = ele mesmo (ou admin, se quiser fechar por ele).
model ProcessRequest {
  id             String    @id @default(cuid())
  processId      String
  organizationId String
  message        String
  requestedById  String
  // Preenchido só na direção (b) — quem precisa resolver esta, além do
  // admin. Null = direção (a) de sempre (só admin resolve).
  targetUserId   String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())

  process      Process      @relation(fields: [processId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("ProcessRequestRequestedBy", fields: [requestedById], references: [id])
  targetUser   User?        @relation("ProcessRequestTargetUser", fields: [targetUserId], references: [id])
  resolvedBy   User?        @relation("ProcessRequestResolvedBy", fields: [resolvedById], references: [id])

  @@index([organizationId, resolvedAt])
  @@index([processId])
}

// ─── Pedido de lead (importação encontra duplicado de outro consultor) ──
// Achado importando uma planilha (ver lib/contacts/import-resolve.ts): uma
// linha "duplicada" (telefone/WhatsApp já cadastrado) aponta pra um Contact
// que já tem responsável ATIVO — quem importa não pode simplesmente tomar o
// lead (isso é diferente do dono já ter SAÍDO da empresa, ver
// OrganizationUser.active, caso que reatribui na hora sem passar por aqui,
// sem gerar linha nenhuma nesta tabela). PENDING até o dono aprovar/recusar
// — aprovar reatribui Contact.responsavelId pro requester (ver PATCH
// /api/lead-requests/[id]).
model LeadRequest {
  id             String            @id @default(cuid())
  organizationId String
  contactId      String
  requesterId    String
  // Dono do contato NO MOMENTO do pedido — guardado à parte de
  // contact.responsavelId (que pode já ter mudado por outro caminho quando
  // alguém for resolver este pedido) pra sempre saber quem deveria aprovar,
  // mesmo que o dono real do contato já tenha mudado nesse meio-tempo.
  ownerId        String
  // Pra quem o contato vai se o pedido for aprovado — normalmente o próprio
  // requester (pedindo pra si), mas pode ser OUTRA pessoa quando quem está
  // solicitando é um admin/assistente importando planilha em nome de
  // alguém (ver "Responsável pra usar em todos" na importação de contatos):
  // aí quem clica e quem recebe o lead são pessoas diferentes. Null = trata
  // como o próprio requesterId (linha antiga, de antes deste campo existir,
  // ou pedido feito sem escolher ninguém — sempre resolvido com
  // `assigneeId ?? requesterId`, nunca lido sozinho).
  assigneeId     String?
  status         LeadRequestStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requester    User         @relation("LeadRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User         @relation("LeadRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("LeadRequestAssignee", fields: [assigneeId], references: [id])
  resolvedBy   User?        @relation("LeadRequestResolvedBy", fields: [resolvedById], references: [id])

  // Sino (ver GET /api/lead-requests) só lista PENDING de um dono — mesmo
  // padrão de índice composto já usado pro resto do app pra essa consulta
  // ser sempre por índice, nunca scan.
  @@index([organizationId, ownerId, status])
  @@index([contactId])
}

enum LeadRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// ─── Modelos de solicitação (documentação/petição) ────────────────────
// Biblioteca de mensagens reaproveitáveis que o administrativo usa pra
// pedir algo (documento, petição) ao consultor ou direto ao cliente — ver
// "Enviar modelo" em process-detail.tsx. Consultor: vira um ProcessRequest
// com targetUserId (ele resolve marcando pronto). Cliente: manda WhatsApp
// direto (lib/whatsapp/send.ts), sem "resolver" — só fica registrado como
// nota + ProcessTemplateUsage.
model ProcessTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // Texto livre, aceita {{cliente.nome}}/{{responsavel.nome}}/{{negocio.nome}}
  // (mesma sintaxe/motor de lib/automations/variables.ts, reaproveitado).
  message        String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation(fields: [createdById], references: [id])
  usages       ProcessTemplateUsage[]

  @@index([organizationId])
}

// Toda vez que um modelo é de fato ENVIADO (não só criado/editado) — serve
// de log de auditoria E de fonte pra ordenar o seletor de modelos de forma
// "inteligente" (ver lib/processes/templates.ts): modelo já usado NESTE
// processo fica pra trás na lista (evita reenviar sem querer), e entre os
// que ainda não foram usados aqui, o mais usado NESTA ETAPA aparece
// primeiro — `stageId` sozinho já basta pra isso porque uma etapa pertence
// a exatamente uma subcategoria (ProcessPipeline) dentro de exatamente uma
// categoria (ProcessCategory), então contar por etapa já conta pelos 3
// níveis de uma vez.
model ProcessTemplateUsage {
  id             String                @id @default(cuid())
  organizationId String
  templateId     String
  processId      String
  stageId        String
  target         ProcessTemplateTarget
  usedById       String
  createdAt      DateTime              @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  process      Process         @relation(fields: [processId], references: [id], onDelete: Cascade)
  stage        ProcessStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  usedBy       User            @relation(fields: [usedById], references: [id])

  @@index([organizationId])
  @@index([templateId, stageId])
  @@index([processId, templateId])
}

enum ProcessTemplateTarget {
  CONSULTANT
  LEAD
}

// ─── Tarefas ─────────────────────────────────────────────────────────

model Task {
  id                       String    @id @default(cuid())
  organizationId           String
  dealId                   String?
  contactId                String?
  ownerId                  String
  type                     TaskType
  title                    String
  description              String?
  dueAt                    DateTime?
  completedAt              DateTime?
  // Quando o convite da reunião (link de "adicionar ao calendário" pro
  // cliente) foi mandado pro WhatsApp dele — null enquanto não mandado.
  // Nunca reseta sozinho num reagendamento; a tela pergunta de novo e quem
  // manda decide se reenvia.
  meetingInviteSentAt      DateTime?
  // Texto (com variáveis {nome}/{cargo}/{empresa}/{cidade}/{consultor}/
  // {saudacao}, ver lib/campaigns/spintax.ts) programado pra ser mandado
  // automaticamente pro WhatsApp do contato no exato dueAt desta tarefa —
  // só faz sentido em tarefas type=WHATSAPP. Preenchido uma vez, na
  // criação (ver ScheduleMessageDialog); nunca editado depois. Renderizado
  // de novo (contato/saudação atuais) só na hora do envio de verdade pelo
  // cron (ver lib/tasks/scheduled-whatsapp.ts) — não fica "congelado" com
  // os dados de quando foi escrito.
  scheduledMessageText     String?
  // Quando o cron mandou de verdade — null enquanto pendente. Setado uma
  // única vez; depois disso o cron nunca mais mexe nesta tarefa (ver
  // scheduledMessageFailedAt abaixo pra falha).
  scheduledMessageSentAt   DateTime?
  // Quando o envio automático falhou de vez (WhatsApp desconectado, contato
  // sem número, etc.) — decisão de produto é NÃO tentar de novo (o
  // consultor é avisado 1x por push e manda manualmente se quiser). Setado
  // uma vez; impede reprocessar a mesma tarefa em todo tick seguinte. Um
  // erro inesperado de infra (não uma falha de envio de verdade) NÃO seta
  // isto — deixa o próximo tick tentar de novo.
  scheduledMessageFailedAt DateTime?
  // "Código da tarefa" do Agendor — mesma ideia de agendorDealId (ver Deal):
  // chave de reconciliação pra reimportar sem duplicar. NÃO é único sozinho
  // porque uma tarefa do Agendor com mais de 1 responsável vira uma linha
  // POR responsável aqui (ver scripts/import-agendor.ts) — o mesmo
  // agendorTaskId aparece então em mais de uma linha de propósito; o que
  // precisa ser único é a combinação com o dono (ver @@unique abaixo).
  agendorTaskId            String?
  // Id do evento criado no Google Agenda do consultor quando a reunião foi
  // marcada via API v1 (ver app/api/v1/appointments/route.ts) — permite
  // atualizar/cancelar o evento de verdade depois. Nulo em toda Task que
  // não é uma reunião sincronizada (todo o resto do CRM, e até reunião
  // marcada por lá quando o consultor não tem GoogleCalendarConnection ou
  // a chamada ao Google falhou nessa hora).
  googleEventId            String?
  // Link do Google Meet devolvido junto com o evento acima, quando criado
  // com conferência (ver createGoogleCalendarEvent em
  // lib/google-calendar-oauth.ts) — só preenchido se o consultor pediu
  // ("Criar link do Google Meet" no MeetingInviteDialog) e tinha a conexão
  // com permissão de escrita. Guardado à parte de googleEventId porque o
  // evento pode existir sem conferência (reunião marcada sem pedir Meet).
  googleMeetLink           String?
  // Aviso automático de WhatsApp antes de uma Reunião — TODOS os campos
  // abaixo são independentes de scheduledMessageText/Sent/FailedAt acima
  // (aquele é o mecanismo mais antigo, só WHATSAPP, 1 mensagem única no
  // dueAt; este é novo, só MEETING, apoia uma SEQUÊNCIA de mensagens com
  // delay entre elas — ver lib/tasks/meeting-reminder.ts). Só existe
  // quando o consultor programou um aviso na criação da reunião
  // (MeetingInviteDialog); nulo em toda Task sem aviso configurado.
  //
  // Minutos de antecedência escolhidos — guardado só pra exibir/editar
  // depois ("aviso configurado: 10 min antes"); quem manda de verdade é
  // reminderNextSendAt abaixo, calculado uma vez na criação.
  reminderMinutesBefore    Int?
  // Sequência resolvida a gravar — [{text, delayAfterSec}], já com
  // variáveis substituídas ou copiada de um MessageScript no momento de
  // programar (mudanças futuras no Script da biblioteca NUNCA alteram um
  // aviso já programado). Mensagem avulsa escrita à mão vira uma
  // sequência de 1 item só (delayAfterSec irrelevante nesse caso).
  reminderSteps            Json?
  // Índice da PRÓXIMA mensagem da sequência a mandar — 0 até a primeira
  // sair. Avança 1 a cada envio; quando chega ao fim (reminderStepIndex
  // == tamanho de reminderSteps), reminderSentAt é setado e o cron para
  // de olhar pra essa tarefa.
  reminderStepIndex        Int?
  // Quando a PRÓXIMA mensagem da sequência deve sair — calculado a
  // primeira vez como dueAt - reminderMinutesBefore minutos; a cada envio
  // vira now + delayAfterSec da mensagem que acabou de sair (delay é
  // "antes da PRÓXIMA", nunca antes da primeira). Decisão explícita do
  // usuário: manda a sequência inteira respeitando os delays originais
  // do Script, mesmo que isso empurre alguma mensagem pra depois do
  // horário da reunião num script longo.
  reminderNextSendAt       DateTime?
  // Setado quando a ÚLTIMA mensagem da sequência sai — nunca mais tocado
  // depois disso (mesmo padrão de scheduledMessageSentAt acima).
  reminderSentAt           DateTime?
  // Setado numa falha permanente (WhatsApp desconectado, contato sem
  // número) — abandona o RESTANTE da sequência, mesma decisão de produto
  // de scheduledMessageFailedAt (sem retry automático, avisa 1x por push).
  reminderFailedAt         DateTime?
  // Aviso automático PUSH pro PRÓPRIO consultor antes de uma Reunião —
  // caminho irmão do bloco reminder* acima (que é WhatsApp pro CLIENTE),
  // escolhido no mesmo botão "Programar aviso automático" do
  // MeetingInviteDialog, agora com um garfo explícito "Avisar cliente" vs
  // "Me avisar". Bem mais simples que o do cliente de propósito: um push
  // só (não uma sequência com Script), texto sempre gerado pelo sistema
  // (nunca escrito à mão) — não faz sentido "escrever uma mensagem" pra um
  // lembrete que só o próprio consultor vê.
  selfReminderMinutesBefore Int?
  // dueAt - selfReminderMinutesBefore minutos, calculado uma vez na
  // criação/edição do aviso — mesmo papel de reminderNextSendAt acima.
  selfReminderSendAt        DateTime?
  // Setado quando o push sai — nunca mais tocado depois (não há sequência
  // pra continuar, é só 1 envio).
  selfReminderSentAt        DateTime?
  createdAt                DateTime  @default(now())
  // Faltava — Task era o único modelo tenant-scoped grande sem @updatedAt.
  // Motivo real de precisar agora: a migração do Agendor (scripts/agendor/
  // import-tarefas.ts) precisa de um jeito de saber se uma Task já
  // importada mudou de data/hora do lado de lá (consultor arrasta a
  // ligação pra outro dia direto no Agendor) sem arriscar reverter uma
  // mudança feita AO VIVO aqui no CRM — mesma guarda que Deal.updatedAt já
  // dá pra syncExistingDeal (import-negocios.ts), agora espelhada aqui.
  updatedAt                DateTime  @updatedAt
  // Liga esta Task à Activity MEETING/VISIT que ela representa — só existe
  // pra type MEETING/VISIT (o resultado agora é perguntado na CONCLUSÃO da
  // tarefa, não na criação: ver ActivityMeetingOutcome.PENDING abaixo e
  // meeting-outcome-dialog.tsx). Preenchido na criação (deal-detail.tsx
  // manda o id da Activity que acabou de criar; POST /api/tasks cria uma
  // companheira sozinho quando ninguém mandou, caso da Agenda solta) e lido
  // de novo na conclusão pra saber qual Activity atualizar com o resultado
  // real. Nulo em toda Task de outro tipo, e em Task MEETING/VISIT criada
  // antes desta coluna existir (PUT cria a Activity na hora nesse caso).
  activityId               String?   @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  owner        User         @relation(fields: [ownerId], references: [id])
  activity     Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  // Trava "1 reunião por horário por consultor" (agendamento via API v1)
  // vive só na migration como índice único PARCIAL (WHERE type='MEETING'),
  // sem representação aqui — Prisma não tem sintaxe pra índice filtrado.
  // Ver 20260814120000_task_meeting_scheduling/migration.sql e
  // feedback_prisma_migrate_gotchas (memória): uma `prisma migrate dev`
  // futura pode tentar gerar um DROP INDEX pra ele por não "ver" essa
  // constraint aqui — checar antes de aplicar.

  @@unique([agendorTaskId, ownerId])
  @@index([organizationId, ownerId, dueAt])
  @@index([organizationId, dealId])
  // Cobre o ORDER BY dueAt da Agenda pra quem enxerga a organização inteira
  // (Dono/Gerente, sem filtro de ownerId) — o índice acima (com ownerId) só
  // ajuda a ordenação quando o filtro de dono também está presente.
  @@index([organizationId, completedAt, dueAt])
}

enum TaskType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VISIT
  PROPOSAL
  NOTE
  OTHER
}

// ─── Histórico de Atividades ─────────────────────────────────────────

model Activity {
  id             String                  @id @default(cuid())
  organizationId String
  dealId         String?
  contactId      String?
  // Nota do administrativo sobre um Processo de pós-venda (ver
  // app/(dashboard)/processos) — mesmo model de atividade do Negócio,
  // reaproveitado em vez de criar um "ProcessNote" à parte só pra isso.
  processId      String?
  userId         String
  type           ActivityType
  body           String?
  createdAt      DateTime                @default(now())
  // "Código da tarefa" do Agendor — só preenchido pra Activity de Reunião/
  // Visita geradas pelo backfill de scripts/agendor/backfill-meeting-visit-activities.ts,
  // que reconstrói o registro de "isso aconteceu" a partir da Task migrada
  // (a migração original só criou Task, ver import-tarefas.ts, e o
  // relatório de Reuniões/Visitas conta de Activity, não de Task — sem
  // isso, todo o histórico migrado ficava invisível em Relatórios).
  // Create-only por (agendorTaskId, userId), mesma chave do Task de
  // origem — nunca preenchido em Activity criada organicamente.
  agendorTaskId  String?
  // Só usado em Activity de Processo (type=NOTE) — null até o consultor
  // dono do processo abrir a tela e ver a nota (ver GET
  // /api/processes/[id]/activities). Nunca preenchido/lido pra qualquer
  // outro tipo de Activity (Negócio, etc.) — sempre null ali, inofensivo.
  readAt         DateTime?
  // Só faz sentido (e só é perguntado) pra type MEETING/VISIT — ver
  // ACTIVITY_BODY_TEMPLATES em lib/activity-icons.tsx e
  // meeting-outcome-dialog.tsx. Qualquer outro type fica sempre null.
  // Histórico anterior a essa coluna existir também fica null — tratado
  // como "compareceu" nas contagens (ver lib/meta-ads/attribution.ts e
  // lib/reports/commercial-data.ts), não como "desconhecido/some da conta":
  // não dá pra saber retroativamente, e assumir não-comparecimento pra tudo
  // que é antigo inflaria o no-show artificialmente. Diferente de
  // PENDING (abaixo) — esse é "ainda não sabemos, mas vamos saber" (tarefa
  // ligada ainda não foi concluída), _esse_ null aqui é "nunca vamos saber".
  meetingOutcome ActivityMeetingOutcome?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  process      Process?     @relation(fields: [processId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  // Lado inverso de Task.activityId — a Task MEETING/VISIT que "gerencia"
  // esta Activity (só preenchido pra Activity criada a partir de uma Task
  // dessas, ver comentário lá).
  task         Task?

  @@unique([agendorTaskId, userId])
  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, processId, createdAt])
  // "Atividades recentes" do Início — da organização toda, sem filtro de
  // negócio/processo, então nenhum dos dois índices acima serve. Era Seq
  // Scan (ver 20260920100000_performance_indexes).
  @@index([organizationId, createdAt])
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  WHATSAPP
  PROPOSAL
  MEETING
  VISIT
  // Gerada pelo próprio sistema (mudança de etapa, ganho/perdido, valor) —
  // nunca criada pelo usuário, renderizada como uma linha minimalista na
  // timeline em vez do cartão das atividades manuais.
  SYSTEM
}

// Resultado de uma Activity type MEETING/VISIT. Perguntado na CONCLUSÃO da
// Task ligada (ver Task.activityId acima e meeting-outcome-dialog.tsx) —
// não mais na criação: perguntar antes do encontro acontecer permitia
// registrar (com um clique só, no default antigo) um comparecimento que
// ainda nem tinha ocorrido. Alimenta o "quantos no-show tomamos" do
// relatório de Facebook (lib/meta-ads/attribution.ts) e a Taxa de
// comparecimento de Relatórios (lib/reports/commercial-data.ts).
enum ActivityMeetingOutcome {
  ATTENDED
  NO_SHOW
  RESCHEDULED
  // Task ligada ainda não foi concluída — só existe entre a criação da
  // tarefa e sua conclusão, nunca é um estado final. Excluído da taxa de
  // comparecimento nos relatórios (mesmo tratamento que RESCHEDULED já
  // recebe) — diferente de meetingOutcome null (Activity acima), que
  // significa "não tem Task ligada pra nunca vir a saber", não "ainda não
  // sabemos".
  PENDING
}

// ─── Atividade diária por usuário (tempo no CRM + nº de alterações) ────
//
// Rollup por dia, não um log de eventos — cada heartbeat do navegador (ver
// lib/user-activity.ts) soma segundos aqui em vez de gravar uma linha por
// heartbeat, e cada mutação de Cliente/Negócio/Tarefa incrementa
// changeCount. Alimenta tanto "está online agora" (lastActiveAt em
// OrganizationUser, não aqui) quanto o relatório "Atividade da equipe".

model UserDailyActivity {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  date           String // "YYYY-MM-DD" em Brasília — mesma convenção de brazilDateKey (lib/timezone.ts)
  activeSeconds  Int      @default(0)
  changeCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date])
  @@index([organizationId, date])
}

/**
 * Quantas vezes cada funcionalidade nomeada foi usada, por pessoa, por dia.
 * Alimenta "onde os consultores mais clicam" (ver lib/feature-usage/) —
 * pedido explícito: "ter um norte de onde melhorar e do que ter mais
 * atenção".
 *
 * SOMATÓRIO diário, não log de evento, pelo mesmo motivo já documentado em
 * UserDailyActivity acima: um consultor clica centenas de vezes por dia, e
 * uma linha por clique seria um volume de escrita enorme pra responder uma
 * pergunta que só precisa de totais. Com (usuário, dia, funcionalidade)
 * único, o navegador pode acumular em memória e mandar de 30 em 30s (de
 * carona no heartbeat que já existe, ver components/presence-heartbeat.tsx —
 * nenhuma requisição nova), e cada envio vira um punhado de incrementos em
 * vez de uma inserção por clique.
 *
 * `feature` é uma chave de uma lista FECHADA (ver FEATURE_LABELS em
 * lib/feature-usage/features.ts) — o servidor descarta o que não estiver
 * nela, pra um cliente adulterado não conseguir inflar a tabela com chaves
 * inventadas.
 */
model FeatureUsageDaily {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  date           String // "YYYY-MM-DD" em Brasília — mesma convenção de brazilDateKey (lib/timezone.ts)
  feature        String
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, date, feature])
  @@index([organizationId, date])
}

// ─── Automações ──────────────────────────────────────────────────────

model AutomationRule {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  trigger        AutomationTrigger
  triggerConfig  Json?
  action         AutomationAction
  actionConfig   Json?
  enabled        Boolean              @default(true)
  runCount       Int                  @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime             @default(now())
  // Null pras regras já existentes antes desta coluna (criadas quando só
  // OWNER/MANAGER tinha acesso, então "sem dono" == só OWNER/MANAGER
  // enxergam). Regras novas de Supervisor/Consultor sempre preenchem isso —
  // é o que restringe a lista de cada um às próprias (ver GET
  // /api/automations), igual ao mesmo padrão já usado em MessageScript.
  createdById    String?
  // Em quem a regra AGE (o gatilho ainda é o mesmo pra organização inteira —
  // isso filtra quais negócios/contatos/tarefas contam como "match", pelo
  // dono da entidade). Só OWNER/MANAGER escolhem isso ao criar/editar (ver
  // app/api/automations) — regra de Supervisor/Consultor é sempre SELF,
  // forçado no servidor, nunca confia no que o cliente manda.
  targetType     AutomationTargetType @default(EVERYONE)
  // Só relevante quando targetType = USERS.
  targetUserIds  String[]             @default([])
  // Só relevante quando targetType = TEAM.
  targetTeamId   String?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                 @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  targetTeam   Team?                 @relation("AutomationRuleTargetTeam", fields: [targetTeamId], references: [id], onDelete: SetNull)
  executions   AutomationExecution[]
  whatsappMessages WhatsAppMessage[]

  @@index([organizationId])
  @@index([organizationId, createdById])
  @@index([organizationId, targetTeamId])
}

enum AutomationTargetType {
  /**
   * Toda a organização (comportamento de sempre, antes deste campo existir).
   */
  EVERYONE
  /**
   * Só o dono da entidade (Deal/Task/Contato) ser igual a quem criou a regra.
   */
  SELF
  /**
   * Só o dono da entidade estar numa lista específica de pessoas escolhidas (targetUserIds).
   */
  USERS
  /**
   * Só o dono da entidade ser membro da equipe escolhida (targetTeamId).
   */
  TEAM
}

model AutomationExecution {
  id        String   @id @default(cuid())
  ruleId    String
  entityId  String
  /**
   * Se a ação realmente aconteceu (mensagem enviada, tarefa criada...) ou falhou — ver lib/automations/engine.ts.
   */
  success   Boolean  @default(true)
  /**
   * Resumo curto e legível do que aconteceu, pra exibir no "Ver detalhes" do histórico.
   */
  detail    String?
  createdAt DateTime @default(now())
  /**
   * Só usado por MESSAGE_RECEIVED — o mesmo `@@unique([ruleId, entityId])`
   * abaixo já impede a MESMA mensagem disparar a MESMA regra duas vezes
   * (entityId = messageId, protege contra reenvio de webhook), mas essa
   * dimensão a mais é o que sustenta a janela deslizante de rate-limit por
   * conversa (ver checkMessageRateLimit em lib/automations/message-trigger.ts)
   * — sem ela não daria pra contar "quantas vezes essa regra disparou pra
   * essa conversa nos últimos 5 minutos" sem escanear a tabela toda.
   */
  threadId String?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, entityId])
  @@index([ruleId, threadId, createdAt])
}

enum AutomationTrigger {
  DEAL_STALE
  DEAL_CREATED
  DEAL_WON
  DEAL_LOST
  TASK_OVERDUE
  DEAL_STAGE_ENTERED
  DEAL_NO_OPEN_TASK
  CONTACT_NO_DEAL
  SCHEDULED
  TASK_DUE_SOON
  /**
   * Mensagem de WhatsApp recebida — ao contrário dos demais (varridos por um
   * cron periódico, ver runAutomations em lib/automations/engine.ts), este é
   * disparado inline pelo próprio webhook (lib/whatsapp/events.ts), porque já
   * nasce sabendo a organização/contato/thread — evento, não estado. Ver
   * lib/automations/message-trigger.ts.
   */
  MESSAGE_RECEIVED
}

enum AutomationAction {
  CREATE_TASK
  ADD_NOTE
  MARK_LOST
  SEND_PUSH
  SEND_WHATSAPP
  SEND_EMAIL
  SET_CUSTOM_FIELD
  SEND_SCRIPT
}

// ─── Integrações externas (API keys + webhooks de saída) ─────────────

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  // Nula = nunca expira (opção "sem expiração" na criação, ver
  // app/(dashboard)/configuracoes/integracoes/api-keys-manager.tsx). Checada
  // em lib/require-api-key.ts a cada chamada — uma chave vazada em log
  // público/repositório não fica válida pra sempre por padrão.
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ─── Audit log administrativo ────────────────────────────────────────
//
// Trilha de ações críticas de administração da conta — login, chaves de
// API, gestão de membros, conexões externas (WhatsApp/Meta/Google). Existe
// pra permitir investigar "quem fez o quê, de onde" se uma conta OWNER for
// comprometida; não é o log de atividade do consultor (ver
// UserDailyActivity, que é sobre produtividade, não segurança).
//
// `action`/`targetType` são String livre (não enum) de propósito — um novo
// tipo de evento não deve exigir uma migration `ALTER TYPE` só pra ser
// logado (ver lib/audit-log.ts pra lista de valores usados hoje).
// `actorName` é congelado no momento do evento (não só uma FK) porque o
// nome do usuário pode mudar depois e o log deve continuar lendo como era.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorName      String
  action         String
  targetType     String?
  targetId       String?
  detail         String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// Ctrl+Z do sistema (ver lib/undo/) — cada linha é UMA ação que pode ser
// revertida: `payload` carrega o que o handler de `type` precisa pra
// reverter (formato específico por type, ver lib/undo/handlers.ts), nunca
// um diff genérico solto. Ao desfazer, a AÇÃO ORIGINAL ganha `undoneAt` e
// uma linha NOVA é criada representando "refazer" (mesmo par undo/redo se
// alternando pra sempre) — por isso não existe um `redoneAt` aqui nem um
// vínculo direto entre as duas linhas: cada uma só sabe reverter A SI
// MESMA, e a cadeia inteira dá pra reconstruir só pela ordem de
// `createdAt`. `undoneAt: null` = ainda desfazível (aviso flutuante de 30s
// OU a página de histórico, sem prazo lá).
model UndoableAction {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String
  description    String
  payload        Json
  undoneAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
}

// ─── Saúde dos crons (infraestrutura, não é dado de organização) ──────
// Registro de CADA execução de um cron (automations/campaigns/db-backup/
// webhooks/whatsapp-health) — sucesso ou falha, com detalhe. Sem
// organizationId de propósito e SEM RLS: um cron quebrado afeta todo mundo
// que usa este deploy igual, não é dado de um tenant específico (mesmo
// raciocínio de Organization, que também não tem RLS — ver
// 20260706172705_init). Ver lib/cron-run.ts (grava) e a página "Saúde do
// sistema" em Configurações, OWNER-only (lê).
model CronRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime
  finishedAt DateTime?
  success    Boolean
  detail     String?

  @@index([name, startedAt])
}

model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  active         Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  organizationId String
  subscriptionId String
  event          String
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, subscriptionId])
  @@index([status, nextAttemptAt])
}

model TvDashboardConfig {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  adsUrls              Json     @default("[]")
  churrascometroTarget Float    @default(0)
  selectedStageIds     Json     @default("[]")
  visibleWidgets       Json     @default("[\"sales_summary\",\"churrascometro\",\"last_sale\",\"funnels\",\"ranking\"]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * Link público (sem login) da TV — só de LEITURA, resolve organizationId a
 * partir do token (nunca do organizationId que o próprio chamador
 * informaria, mesmo raciocínio de segurança do ApiKey, ver
 * lib/require-api-key.ts). Deliberadamente um model PRÓPRIO, não reaproveita
 * ApiKey: uma ApiKey autentica a API pública inteira (cria/edita/apaga
 * negócio), poder demais pra um token que vai ficar exposto na configuração
 * de um dispositivo de TV pendurado numa sala — o escopo deste token é
 * restrito por CONSTRUÇÃO (só existe um lookup, lib/require-tv-link.ts, que
 * só devolve organizationId, nunca dá pra usar em nenhuma outra rota).
 *
 * Um token ativo por organização na prática (a UI em Configurações → TV só
 * mostra "gerar"/"revogar e gerar outro", nunca uma lista) — mas nada aqui
 * impede mais de um por organização (histórico de revogados fica guardado,
 * mesmo padrão soft-revoke do ApiKey).
 */
model TvDisplayLink {
  id             String    @id @default(cuid())
  organizationId String
  tokenPrefix    String
  tokenHash      String    @unique
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ─── Cartão Digital ──────────────────────────────────────────────────
//
// Cartão de visita digital (QR Code + link permanente) pra consultor/
// diretor apresentar presencialmente ou compartilhar. Fonte de verdade
// continua sendo User/OrganizationUser — este model só guarda o que o User
// NÃO tem hoje (cargo, bio, telefone/WhatsApp público, endereço, valor em
// carteira) + overrides opcionais (foto, e-mail) pra quem quer algo
// diferente no cartão do que no resto do CRM. Nome/e-mail/foto default
// SEMPRE lidos do User em tempo de render (ver lib/digital-cards/queries.ts)
// — nunca copiados pra cá, pra nunca dessincronizar se a pessoa trocar de
// nome/foto no perfil.
//
// 1 cartão por usuário (userId @unique) — igual "ativar um Cartão Digital
// pra ele" foi pedido, não uma lista de cartões por pessoa.
//
// slug é ÚNICO GLOBAL (não por organização) — a URL pública
// (cartao.reobote.com.br/c/marcelo-souza) não carrega segmento de
// organização nenhum, mesmo formato já usado por Organization.slug (também
// global neste projeto). Se outra organização um dia usar o mesmo sistema,
// dois slugs iguais colidiriam — aceito conscientemente, é o formato de URL
// pedido.
model DigitalCard {
  id             String  @id @default(cuid())
  organizationId String
  userId         String  @unique
  slug           String  @unique
  // Default da COLUNA é false só como rede de segurança (nunca fica público
  // sozinho por causa de um insert que esqueceu de passar este campo) — o
  // fluxo de verdade (getOrCreateOwnCard, lib/digital-cards/queries.ts) já
  // passa `active: true` explicitamente na criação (pedido explícito: "o
  // cartão já deve vir ativo" — sem passo extra de ativar antes de poder
  // compartilhar o link). Continua editável (dá pra desativar depois).
  active         Boolean @default(false)

  jobTitle String? // User não tem cargo hoje — só existe aqui.
  bio      String?
  // "Reobote Consórcios" como default sensato, mas editável (pedido cobre
  // "empresa" como campo próprio do cartão).
  companyName String? @default("Reobote Consórcios")
  // Override da foto — null = cai pro User.image (ver
  // lib/digital-cards/queries.ts). Mesma convenção de chave do avatar
  // normal (ver lib/r2.ts), bucket privado + URL assinada.
  photoKey String?
  // Foto de capa (banner do topo do cartão) — opcional, por cartão. null =
  // cai pro gradiente abstrato padrão (ver components/digital-card/
  // digital-card-view.tsx). Mesmo bucket privado + URL assinada do
  // photoKey acima, prefixo de chave próprio (buildCardCoverPhotoKey em
  // lib/r2.ts) — pedido explícito do usuário depois de discutir a ideia do
  // Gemini sobre foto de fundo do cartão.
  coverPhotoKey String?
  // Foto de fundo do CORPO INTEIRO do cartão (atrás dos botões/ícones/
  // rodapé, não só atrás do avatar como coverPhotoKey acima) — pedido
  // explícito: "a capa de fundo atrás do avatar e outra de fundo com todo
  // o corpo do cartão" são DUAS imagens distintas na referência. Mesmo
  // mecanismo de override+padrão da organização+voltar ao padrão do
  // coverPhotoKey (ver lib/digital-cards/config.ts).
  backgroundPhotoKey String?
  // Override do e-mail — null = usa User.email.
  emailOverride String?
  // Telefone/WhatsApp públicos do cartão — User não tem telefone hoje.
  // whatsapp é PRÉ-preenchido a partir da WhatsAppInstance conectada do
  // usuário no momento da criação do cartão (ver
  // app/api/digital-cards/route.ts), mas vira um campo próprio e editável
  // depois disso — trocar de instância no CRM não muda o cartão sozinho.
  phone    String?
  whatsapp String?
  // Texto livre — alimenta o botão "Mapa" (query pro Google Maps) e o
  // campo ADR do vCard. Não é o endereço estruturado de Contact
  // (address/addressNumber/...) de propósito: cartão de visita não precisa
  // desse nível de estrutura, só de um texto que abre bem no Maps.
  address String?

  // Valor em carteira — comercialmente sensível, por isso off por padrão e
  // sempre um TEXTO livre formatado (nunca um número puro): "+R$ 5
  // milhões", "Mais de R$ 5 milhões" etc., nunca dado exato exposto sem a
  // pessoa escolher como.
  showPortfolioValue    Boolean @default(false)
  portfolioValueDisplay String?

  // Quais logos parceiras aparecem e em que ordem (ver
  // lib/digital-cards/logos.ts, AVAILABLE_PARTNER_LOGOS) — array de "key"
  // (ex.: ["reobote","servopa","rodobens"]), na ordem de exibição. Vazio =
  // cai pro DEFAULT_SELECTED_LOGOS (todas, ordem padrão) — nunca um cartão
  // sem logo nenhuma só porque a coluna começou vazia antes desta migration.
  selectedLogos String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links         DigitalCardLink[]
  events        DigitalCardEvent[]
  presentations DigitalCardPresentation[]

  @@index([organizationId])
}

enum DigitalCardLinkType {
  INSTAGRAM
  LINKEDIN
  WEBSITE
  FACEBOOK
  YOUTUBE
  OTHER
}

model DigitalCardLink {
  id     String              @id @default(cuid())
  cardId String
  type   DigitalCardLinkType
  label  String
  url    String
  order  Int                 @default(0)
  active Boolean             @default(true)

  card DigitalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

enum DigitalCardEventType {
  CARD_VIEW
  QR_PRESENTED
  // Botão "QR Code" clicado (manual ou via ?qr=1 automático, ver
  // digital-card-actions.tsx) — distinto de QR_PRESENTED, que é o consultor
  // abrindo "Meu QR Code" dentro do CRM (lado de quem apresenta); este é o
  // lado de quem está NA página pública abrindo o modal do QR.
  QR_CODE_OPEN
  CLIENT_ACCESSED
  CLIENT_REFUSED
  WHATSAPP_CLICK
  PHONE_CLICK
  EMAIL_CLICK
  MAP_CLICK
  INSTAGRAM_CLICK
  LINKEDIN_CLICK
  LINK_CLICK
  VCARD_DOWNLOAD
  SHARE_CLICK
}

/**
 * Evento de analytics do cartão — sempre gravado a partir de um
 * organizationId JÁ resolvido (a página pública resolve via
 * runWithCardSlugLookup uma vez, e escreve o evento com runWithTenant
 * normal depois, ver lib/digital-cards/events.ts) — este model não precisa
 * de policy de bootstrap própria, diferente de DigitalCard. Nunca guarda
 * dado pessoal do visitante — só o tipo de evento, uma sessão anônima
 * (cookie aleatório, nunca fingerprint) e a origem (?src=qr/whatsapp/...).
 */
model DigitalCardEvent {
  id             String               @id @default(cuid())
  organizationId String
  cardId         String
  eventType      DigitalCardEventType
  sessionId      String?
  source         String?
  metadata       Json?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         DigitalCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, eventType, createdAt])
  @@index([organizationId])
}

enum PresentationResponse {
  ACCESSED
  REFUSED
  SELF_VIEW
  PENDING
}

/**
 * Uma sessão de apresentação presencial — criada quando o consultor abre
 * "Meu QR Code" pra mostrar ao cliente (ver
 * components/digital-card/use-presentation-session.ts). Como o QR é
 * permanente (nunca um link de uso único, pedido explícito), não existe
 * prova técnica de que UM acesso específico veio desta apresentação —
 * automaticAccessDetected é só uma DICA (houve CARD_VIEW deste cartão
 * nessa janela de tempo?), nunca a resposta em si: quem decide
 * consultantResponse é sempre o próprio consultor, respondendo à pergunta
 * pós-apresentação.
 */
model DigitalCardPresentation {
  id                      String               @id @default(cuid())
  organizationId          String
  cardId                  String
  consultantUserId        String
  startedAt               DateTime             @default(now())
  endedAt                 DateTime?
  consultantResponse      PresentationResponse @default(PENDING)
  automaticAccessDetected Boolean              @default(false)
  visitorSessionId        String?
  whatsappClicked         Boolean              @default(false)
  vcardDownloaded         Boolean              @default(false)
  instagramClicked        Boolean              @default(false)
  createdAt               DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  card         DigitalCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  consultant   User         @relation(fields: [consultantUserId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([consultantUserId, createdAt])
  @@index([organizationId])
}

enum ProductivityTipType {
  WHATSAPP_DISCONNECTED
  NOSHOW_DEALS
  MANY_WHATSAPP_TASKS
  STALE_DEALS
  NO_MESSAGE_SCRIPTS
}

// Dispensa de uma dica de produtividade (ver lib/productivity-tips/) — por
// usuário, por tipo de dica, por escopo (ex.: uma etapa específica de
// no-show) e por dia (dismissDate = início do dia local em que foi
// dispensada; forever=true ignora o dia e nunca mais mostra esse tipo/
// escopo pra esse usuário). organizationId próprio (mesmo padrão de
// UndoableAction) — RLS simples direto na coluna, sem subquery.
model ProductivityTipDismissal {
  id             String              @id @default(cuid())
  organizationId String
  tipType        ProductivityTipType
  scope          String              @default("GLOBAL")
  dismissDate    DateTime
  forever        Boolean             @default(false)
  dismissedBy    String
  dismissedAt    DateTime            @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dismissedByUser User         @relation(fields: [dismissedBy], references: [id], onDelete: Cascade)

  @@unique([tipType, scope, dismissedBy, dismissDate, forever])
  @@index([organizationId, dismissedBy, tipType, scope])
}
